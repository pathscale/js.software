// The preamble, and the reason each page is reached with `click` rather than
// `open`, are both described in `actions.ron`.
//
// The Surfaces category: Glass Panel, Glow Card, Noise Background, and the
// Complete Coverage lab.
//
// The first three are backgrounds. They have no roles, no labels and nothing to
// press, so what a check can ask about them is that the page mounted and that
// the sections which vary a parameter -- a gradient, a noise level, a speed --
// each produced their own example rather than one of them taking the page down.
//
// Complete Coverage is the opposite and is why this group is worth running. It
// is one page carrying every public family that has no showcase of its own, so
// it is the broadest single assertion in the suite that `@pathscale/ui` mounts:
// a family that stops building leaves a hole here and nowhere else.
[
    (
        id: "the-surfaces-group-starts-from-a-page-that-clears-the-menu",
        group: "surfaces",
        what: "the run reaches a route whose navigation resets the component disclosure",
        open: Some("Docs"),
        hover: None,
        click: None,
        subject: "heading:Quick Start",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-surfaces-group-opens-the-component-menu",
        group: "surfaces",
        what: "the component index offers its categories when asked",
        open: None,
        hover: None,
        click: Some("Components"),
        subject: "button:Surfaces",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-surfaces-group-selects-its-category",
        group: "surfaces",
        what: "picking a category lists the pages under it",
        open: None,
        hover: None,
        click: Some("button:Surfaces"),
        subject: "link:Glow Card",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    // Glass Panel.
    (
        id: "the-glass-panel-page-opens",
        group: "surfaces",
        what: "the menu reaches the Glass Panel showcase",
        open: None,
        hover: None,
        click: Some("link:Glass Panel"),
        subject: "heading:Glass Panel",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-glass-panel-page-documents-the-tokens-it-reads",
        group: "surfaces",
        what: "the panel is theme-driven, and the theme variables are listed",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Theme CSS Variables",
        expect: Present,
    ),
    (
        id: "the-glass-panel-page-covers-the-transparent-variant",
        group: "surfaces",
        what: "the last section rendered rather than the page stopping at the default",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Transparent Variant",
        expect: Present,
    ),
    // Glow Card.
    (
        id: "the-glow-card-page-opens",
        group: "surfaces",
        what: "the menu reaches the Glow Card showcase",
        open: None,
        hover: None,
        click: Some("link:Glow Card"),
        subject: "heading:Glow Card",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-glow-card-page-draws-a-grid-of-them",
        group: "surfaces",
        what: "three glow cards side by side, so the effect composes rather than claiming the page",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Reports",
        expect: Present,
    ),
    (
        id: "and-the-grid-reaches-its-third-card",
        group: "surfaces",
        what: "the last of the three cards mounted rather than the row stopping at two",
        open: None,
        hover: None,
        click: None,
        // This was `heading:Settings` right of `heading:Reports`, and there is
        // no fontless form of it. Every geometric assertion in the vocabulary
        // filters to nodes that paint, and nothing on the Glow Card page
        // paints: the cards are anonymous containers and every named node on
        // the page is a heading, so all three resolve to 238x0 with no font
        // catalogue. Their x offsets do say 249, 553 and 857, which is the
        // side-by-side the old check wanted, but no `expect` can read a box
        // that has no height.
        //
        // What is left is the third card's own existence. That the grid is a
        // row rather than a stack is not checked here any more; it is checked
        // by eye, or on a host with fonts.
        subject: "heading:Settings",
        expect: Present,
    ),
    // Noise Background.
    (
        id: "the-noise-background-page-opens",
        group: "surfaces",
        what: "the menu reaches the Noise Background showcase",
        open: None,
        hover: None,
        click: Some("link:Noise Background"),
        subject: "heading:Noise Background",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-noise-background-page-varies-its-gradient",
        group: "surfaces",
        what: "the custom-colour section produced both of its examples",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Purple Haze",
        expect: Present,
    ),
    (
        id: "and-its-animation-speed",
        group: "surfaces",
        what: "the last section on the page rendered, which an animation that wedges would prevent",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Speed variations",
        expect: Present,
    ),
    // Complete Coverage.
    (
        id: "the-coverage-page-opens",
        group: "surfaces",
        what: "the menu reaches the complete coverage lab",
        open: None,
        hover: None,
        click: Some("link:Complete Coverage"),
        subject: "heading:Complete Coverage",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-coverage-page-builds-a-grouped-choice",
        group: "surfaces",
        what: "the radio group family mounted with its label and its options",
        open: None,
        hover: None,
        click: None,
        subject: "radiogroup:Change text size",
        expect: Paints,
    ),
    (
        id: "and-one-of-its-options-starts-chosen",
        group: "surfaces",
        what: "a one-of-many control has a value rather than an empty set",
        open: None,
        hover: None,
        click: None,
        subject: "radio:Size XL",
        expect: Enabled,
    ),
    (
        id: "the-coverage-page-builds-a-colour-area",
        group: "surfaces",
        what: "the two-dimensional picker mounted, which is the component with the most to go wrong",
        open: None,
        hover: None,
        click: None,
        subject: "slider:Color area",
        expect: Measures,
        expect_size: Some("200x200"),
    ),
    (
        id: "and-a-hue-slider-beside-it",
        group: "surfaces",
        what: "the one-dimensional half of the same picker is there too",
        open: None,
        hover: None,
        click: None,
        subject: "slider:Hue",
        expect: Paints,
    ),
    (
        id: "the-coverage-page-builds-a-combobox",
        group: "surfaces",
        what: "the typed-selection family mounted with a control to open it",
        open: None,
        hover: None,
        click: None,
        subject: "button:Toggle options",
        expect: Enabled,
    ),
    (
        id: "the-coverage-page-builds-a-meter",
        group: "surfaces",
        what: "meter is its own role, distinct from progressbar, and both are on this page",
        open: None,
        hover: None,
        click: None,
        subject: "meter:",
        expect: Paints,
    ),
    (
        id: "and-a-progressbar-that-is-not-one",
        group: "surfaces",
        what: "the two are rendered side by side, so the roles can be told apart",
        open: None,
        hover: None,
        click: None,
        subject: "progressbar:",
        expect: Count,
        expect_count: Some(2),
    ),
    (
        id: "the-coverage-page-builds-an-empty-state",
        group: "surfaces",
        what: "the empty family announces itself as a status region here as well",
        open: None,
        hover: None,
        click: None,
        subject: "status:Nothing here",
        expect: Paints,
    ),
    (
        id: "the-coverage-page-builds-a-language-control",
        group: "surfaces",
        what: "the locale control names the language currently in force",
        open: None,
        hover: None,
        click: None,
        subject: "button:Current language: English",
        expect: Enabled,
    ),
    (
        id: "and-a-theme-control",
        group: "surfaces",
        what: "the theme control is named for what it does rather than for its icon",
        open: None,
        hover: None,
        click: None,
        subject: "button:Change theme color",
        expect: Enabled,
    ),
    (
        id: "the-coverage-page-builds-a-labelled-checkbox-pair",
        group: "surfaces",
        what: "a checkbox group here carries the labels the Checkbox showcase mostly omits",
        open: None,
        hover: None,
        click: None,
        subject: "checkbox:Second",
        expect: Enabled,
    ),
    (
        id: "the-coverage-page-builds-a-toolbar",
        group: "surfaces",
        what: "the toolbar family mounted outside the Dock page",
        open: None,
        hover: None,
        click: None,
        // The toolbar's height is its contents', and its contents are text:
        // 862x0 with no font catalogue. That the `toolbar` role exists at all
        // is the assertion -- this page is the only place the family mounts.
        subject: "toolbar:",
        expect: Present,
    ),
    (
        id: "the-coverage-page-builds-a-field-with-helper-text",
        group: "surfaces",
        what: "a field's description reaches its accessible name rather than sitting beside it",
        open: None,
        hover: None,
        click: None,
        subject: "textbox:Helper text.",
        expect: Paints,
    ),
]
