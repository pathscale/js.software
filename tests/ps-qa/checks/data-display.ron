// The Data display category: Avatar, Badge, Card, Chat Bubble, Data Grid,
// Empty, Kbd, Table.
//
// The preamble is the one described in `actions.ron`: land on a route that
// clears the component disclosure, open the menu, select this category. So is
// the reason each page is reached with `click` rather than `open`.
//
// The Data Grid is the reason this group is worth more than a page walk. It is
// the only component on the site that owns state -- a query, a page, a
// selection -- so it is the only one whose controls can be driven and read back
// rather than merely counted. Everything it changes here it changes back.
[
    (
        id: "the-data-display-group-starts-from-a-page-that-clears-the-menu",
        group: "data-display",
        what: "the run reaches a route whose navigation resets the component disclosure",
        open: Some("Docs"),
        hover: None,
        click: None,
        subject: "heading:Quick Start",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-data-display-group-opens-the-component-menu",
        group: "data-display",
        what: "the component index offers its categories when asked",
        open: None,
        hover: None,
        click: Some("Components"),
        subject: "button:Data display",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-data-display-group-selects-its-category",
        group: "data-display",
        what: "picking a category lists the pages under it",
        open: None,
        hover: None,
        click: Some("button:Data display"),
        subject: "link:Chat Bubble",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    // Avatar.
    (
        id: "the-avatar-page-opens",
        group: "data-display",
        what: "the menu reaches the Avatar showcase",
        open: None,
        hover: None,
        click: Some("link:Avatar"),
        subject: "heading:Avatar",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-avatar-page-loads-every-image",
        group: "data-display",
        what: "each example fetched and mounted its image",
        open: None,
        hover: None,
        click: None,
        // One default, three sizes, two variants. An avatar whose source fails
        // still occupies a box, so the count is what says the examples are all
        // there.
        subject: "img:User avatar",
        expect: Count,
        expect_count: Some(6),
    ),
    (
        id: "the-avatar-page-covers-the-fallback",
        group: "data-display",
        what: "the case with no image to load has its own section",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Fallback",
        expect: Present,
    ),
    // Badge.
    (
        id: "the-badge-page-opens",
        group: "data-display",
        what: "the menu reaches the Badge showcase",
        open: None,
        hover: None,
        click: Some("link:Badge"),
        subject: "heading:Badge",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-badge-page-anchors-a-badge-to-a-control",
        group: "data-display",
        what: "the anchored example rendered as a square icon button with its badge",
        open: None,
        hover: None,
        click: None,
        subject: "button:Inbox",
        expect: Measures,
        expect_size: Some("32x32"),
    ),
    (
        id: "the-badge-page-offers-all-four-placements",
        group: "data-display",
        what: "the placement row rendered to its end",
        open: None,
        hover: None,
        click: None,
        subject: "button:bottom-right",
        expect: Paints,
    ),
    (
        id: "the-badge-page-points-standalone-labels-elsewhere",
        group: "data-display",
        what: "the guidance that a bare label is a Tag rather than a Badge is on the page",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Standalone labels use Tag",
        expect: Present,
    ),
    // Card.
    (
        id: "the-card-page-opens",
        group: "data-display",
        what: "the menu reaches the Card showcase",
        open: None,
        hover: None,
        click: Some("link:Card"),
        subject: "heading:Card",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-card-page-draws-a-card-with-an-action",
        group: "data-display",
        what: "the default card carries its body and its button",
        open: None,
        hover: None,
        click: None,
        subject: "button:Buy Now",
        expect: Paints,
    ),
    (
        id: "the-card-page-loads-a-card-image",
        group: "data-display",
        what: "the image variant fetched its media rather than leaving a gap",
        open: None,
        hover: None,
        click: None,
        subject: "img:Shoes",
        expect: Paints,
    ),
    (
        id: "the-card-page-makes-a-pressable-card-a-button",
        group: "data-display",
        what: "a card that acts like a button says so in its role",
        open: None,
        hover: None,
        click: None,
        // The whole card is one control, and its accessible name is its
        // content. That is the contract the component claims for `isPressable`,
        // and this is where it would be noticed if it stopped holding.
        subject: "button:Press me",
        expect: Paints,
    ),
    (
        id: "the-card-page-separates-hoverable-from-pressable",
        group: "data-display",
        what: "the two interactive treatments are both demonstrated",
        open: None,
        hover: None,
        click: None,
        subject: "article:Hover me",
        expect: Paints,
    ),
    // Chat Bubble.
    (
        id: "the-chat-bubble-page-opens",
        group: "data-display",
        what: "the menu reaches the Chat Bubble showcase",
        open: None,
        hover: None,
        click: Some("link:Chat Bubble"),
        subject: "heading:Chat Bubble",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-chat-bubble-page-reaches-its-last-section",
        group: "data-display",
        what: "a long page rendered past the fold rather than stopping at the first example",
        open: None,
        hover: None,
        click: None,
        subject: "heading:With Header and Footer",
        expect: Present,
    ),
    // Data Grid. The interesting half of this group.
    (
        id: "the-data-grid-page-opens",
        group: "data-display",
        what: "the menu reaches the Data Grid showcase",
        open: None,
        hover: None,
        click: Some("link:Data Grid"),
        subject: "heading:Data Grid",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-data-grid-offers-a-filter-per-column",
        group: "data-display",
        what: "the search row rendered a field for each searchable column",
        open: None,
        hover: None,
        click: None,
        subject: "textbox:Search Last Name",
        expect: Paints,
    ),
    (
        id: "the-data-grid-starts-on-its-first-page",
        group: "data-display",
        what: "there is nothing before the first page, and the control says so",
        open: None,
        hover: None,
        click: None,
        subject: "button:Previous page",
        expect: Disabled,
    ),
    (
        id: "and-there-is-a-page-after-it",
        group: "data-display",
        what: "the disabled assertion above is about position rather than a dead pager",
        open: None,
        hover: None,
        click: None,
        subject: "button:Next page",
        expect: Enabled,
    ),
    (
        id: "and-the-pager-advances",
        group: "data-display",
        what: "paging forward is what unlocks paging back",
        open: None,
        hover: None,
        click: Some("button:Next page"),
        subject: "button:Previous page",
        expect: Enabled,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "and-the-last-page-has-nothing-after-it",
        group: "data-display",
        what: "the pager knows where the data ends",
        open: None,
        hover: None,
        click: None,
        subject: "button:Next page",
        expect: Disabled,
    ),
    (
        id: "and-the-pager-goes-back",
        group: "data-display",
        what: "the group leaves the grid on the page it found it on",
        open: None,
        hover: None,
        click: Some("button:Previous page"),
        subject: "button:Next page",
        expect: Enabled,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-data-grid-offers-a-selection-column",
        group: "data-display",
        what: "the selection example drew a checkbox per row and one for all of them",
        open: None,
        hover: None,
        click: None,
        // Five rows plus the header's select-all. Rows themselves are
        // anonymous -- the engine does not name a cell from its content -- so
        // the row checkboxes are what makes the family countable.
        subject: "checkbox:Select row",
        expect: Count,
        expect_count: Some(5),
    ),
    (
        id: "and-a-way-to-select-all-of-them",
        group: "data-display",
        what: "the header checkbox is named for what it does",
        open: None,
        hover: None,
        click: None,
        subject: "checkbox:Select all rows",
        expect: Paints,
    ),
    (
        id: "and-something-to-do-with-a-selection",
        group: "data-display",
        what: "the example wires the selection to an action",
        open: None,
        hover: None,
        click: None,
        subject: "button:Log selection",
        expect: Enabled,
    ),
    (
        id: "the-data-grid-documents-the-port-from-vue3-ui",
        group: "data-display",
        what: "the migration section, which is why this page is long, is present",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Porting from vue3-ui",
        expect: Present,
    ),
    // Empty. Opened by its own control rather than by its heading: the Data
    // Grid page has a section called `Empty` too, and a heading subject would
    // let the check decide it had already arrived without navigating.
    (
        id: "the-empty-page-opens",
        group: "data-display",
        what: "the menu reaches the Empty showcase",
        open: None,
        hover: None,
        click: Some("link:Empty"),
        subject: "button:Create project",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-empty-state-is-announced-rather-than-only-drawn",
        group: "data-display",
        what: "an empty state is a status region, so it reaches a screen reader",
        open: None,
        hover: None,
        click: None,
        subject: "status:No projects yet",
        expect: Paints,
    ),
    // Kbd.
    (
        id: "the-kbd-page-opens",
        group: "data-display",
        what: "the menu reaches the Kbd showcase",
        open: None,
        hover: None,
        click: Some("link:Kbd"),
        subject: "heading:Kbd",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-kbd-page-lays-out-a-whole-keyboard",
        group: "data-display",
        what: "the largest example on the page rendered",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Full Keyboard",
        expect: Present,
    ),
    // Table.
    (
        id: "the-table-page-opens",
        group: "data-display",
        what: "the menu reaches the Table showcase",
        open: None,
        hover: None,
        click: Some("link:Table"),
        subject: "heading:Table",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-table-page-draws-a-row-action-per-row",
        group: "data-display",
        what: "the table rendered all four of its rows",
        open: None,
        hover: None,
        click: None,
        subject: "button:details",
        expect: Count,
        expect_count: Some(4),
    ),
    (
        id: "the-table-page-loads-its-row-images",
        group: "data-display",
        what: "a cell can carry a component, and this one carries an avatar",
        open: None,
        hover: None,
        click: None,
        subject: "img:Hart Hagerty",
        expect: Paints,
    ),
    (
        id: "the-table-page-documents-its-parts",
        group: "data-display",
        what: "the headless parts are listed, which is the point of this page",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Table.Column",
        expect: Present,
    ),
]
