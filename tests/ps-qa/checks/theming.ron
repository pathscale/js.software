        what: "the popover dismisses, and this group changes nothing it cannot put back",
        open: None,
        hover: None,
        click: Some("button:Done"),
        subject: "button:red-500",
        expect: Vanishes,
        outcome_timeout_ms: 8000,
    ),
    // Randomizing must change a rendered token. A status message or a still-live
    // reactive system is insufficient: production once accepted the callback
    // while CSP blocked the inline custom properties that paint the result.
    (
        id: "the-theme-randomizer-visibly-changes-a-token",
        group: "theming",
        what: "Random visibly repaints the live component preview",
        open: None,
        hover: None,
        click: Some("button:Random"),
        subject: "#theme-preview",
        expect: PixelsChange,
        outcome_timeout_ms: 8000,
    ),
    // The editor must remain reactive after a full theme regeneration too.
    (
        id: "the-theme-can-be-randomized",
        group: "theming",
        what: "the randomize control runs without taking the editor down with it",
        open: None,
        hover: None,
        click: Some("button:Random"),
        subject: "button:Reset glass settings",
