// The theme editor, which is the only page on this site that is an application
// rather than a document.
//
// It is worth its own group because it is the one surface where the library is
// driven rather than displayed: the left column writes custom properties and the
// right column is a live preview built from the components those properties
// style. A theme token that stops resolving shows up here first, and nowhere
// else on the site does a control change anything.
//
// This group changes only things it puts back. The colour popover is opened and
// closed, and no colour is committed.
//
// Export is a real UI Dialog. The last pair opens it, proves the generated CSS
// is available in a named UI Textarea, and closes it again.
[
    (
        id: "the-theme-editor-opens",
        group: "theming",
        what: "the header reaches the theme editor",
        open: Some("Theming"),
        hover: None,
        click: None,
        subject: "heading:Theme Editor",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-editor-offers-the-colour-tokens",
        group: "theming",
        what: "the colour section rendered, not only the page title",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Compose Theme",
        expect: Present,
    ),
    (
        id: "the-theme-composer-uses-the-full-flower",
        group: "theming",
        what: "the theme builder exposes 30 colours around a neutral reset centre",
        open: None,
        hover: None,
        click: None,
        subject: "radio:Theme color #",
        expect: Count,
        expect_count: Some(30),
    ),
    (
        id: "the-theme-composer-exposes-both-colour-modes",
        group: "theming",
        what: "the theme builder exposes explicit light and dark composition modes",
        open: None,
        hover: None,
        click: None,
        subject: "button:* mode",
        expect: Count,
        expect_count: Some(2),
    ),
    (
        id: "the-theme-composer-switches-colour-mode",
        group: "theming",
        what: "changing mode rebuilds the surface ladder and selects the requested mode",
        open: None,
        prepare: Some("button:Dark mode"),
        hover: None,
        click: Some("button:Light mode"),
        subject: "button:Light mode",
        expect: SelectionChanges,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-theme-flower-updates-the-surface",
        group: "theming",
        what: "choosing a flower petal changes the selected surface colour",
        open: None,
        prepare: Some("radio:Reset to neutral"),
        hover: None,
        click: Some("radio:Theme color #"),
        subject: "#theme-preview-glass-card",
        expect: PixelsChange,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-theme-composer-offers-five-strength-stops",
        group: "theming",
        what: "surface strength is a deliberate five-stop UI control",
        open: None,
        hover: None,
        click: None,
        subject: "button:Colour strength",
        expect: Count,
        expect_count: Some(5),
    ),
    (
        id: "the-theme-composer-updates-strength",
        group: "theming",
        what: "a strength choice updates the surface composition",
        open: None,
        prepare: Some("button:Colour strength 10%"),
        hover: None,
        click: Some("button:Colour strength 50%"),
        subject: "button:Colour strength 50%",
        expect: SelectionChanges,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "theme-strength-repaints-the-preview",
        group: "theming",
        what: "surface strength visibly changes the composed component preview",
        open: None,
        prepare: Some("button:Colour strength 10%"),
        hover: None,
        click: Some("button:Colour strength 50%"),
        subject: "#theme-preview-glass-card",
        expect: PixelsChange,
        outcome_timeout_ms: 2500,
    ),
    (
        id: "the-theme-composer-offers-control-accent-friends",
        group: "theming",
        what: "the flower is paired with seven control-accent harmonies",
        open: None,
        hover: None,
        click: None,
        subject: "button:Control accent",
        expect: Count,
        expect_count: Some(7),
    ),
    (
        id: "the-theme-composer-updates-the-control-accent",
        group: "theming",
        what: "choosing a control accent updates its selected harmony",
        open: None,
        prepare: Some("button:Control accent 2"),
        hover: None,
        click: Some("button:Control accent 1"),
        subject: "button:Control accent 1",
        expect: SelectionChanges,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-theme-composer-offers-artwork-accent-friends",
        group: "theming",
        what: "artwork colour remains independent from the control accent",
        open: None,
        hover: None,
        click: None,
        subject: "button:Artwork accent",
        expect: Count,
        expect_count: Some(7),
    ),
    (
        id: "the-theme-composer-updates-the-artwork-accent",
        group: "theming",
        what: "choosing an artwork accent updates its selected harmony",
        open: None,
        prepare: Some("button:Artwork accent 2"),
        hover: None,
        click: Some("button:Artwork accent 1"),
        subject: "button:Artwork accent 1",
        expect: SelectionChanges,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "and-a-swatch-per-token",
        group: "theming",
        what: "each colour token is a control a person can press",
        open: None,
        hover: None,
        click: None,
        // The base surface token, named for the custom property it writes.
        // A swatch is a coloured square with no label, so its box is its own
        // rather than its text's: this is one of the few assertions on this
        // site that a host with no fonts would still measure.
        subject: "button:--color-base-100",
        expect: Measures,
        expect_size: Some("24x24"),
    ),
    (
        id: "and-the-full-token-set-rather-than-a-few",
        group: "theming",
        what: "every colour role has a swatch, content colours included",
        open: None,
        hover: None,
        click: None,
        // Ten roles, each with a content colour. Counting them is what
        // distinguishes a rendered palette from a section header with one
        // stray square under it.
        subject: "button:--color-",
        expect: Count,
        expect_count: Some(20),
    ),
    (
        id: "the-editor-offers-the-shape-tokens",
        group: "theming",
        what: "radius, sizes and effects are all present",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Radius",
        expect: Present,
