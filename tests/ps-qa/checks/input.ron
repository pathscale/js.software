// The preamble, and the reason each page is reached with `click` rather than
// `open`, are both described in `actions.ron`.
//
// The Input category: Checkbox, File Input, Form, Input, Radio Group, Select,
// Slider, Textarea.
//
// Two of the ten pages in this category are reached but never opened, and the
// reason is written into the first two checks. `/calendar` and `/color-picker`
// both take the whole application down when they mount, and every group runs
// against one shared browser, so opening either would end the run there and
// report every later group as a failure of its own.
//
// What takes them down:
//
//   `/calendar`      `ReferenceError: Intl is not defined`. The engine has no
//                    `Intl`, and the date formatting reaches for it during the
//                    first render. Not the site's doing.
//
//   `/color-picker`  `useColorPickerContext must be used within a
//                    ColorPickerContext.Provider`. The page renders
//                    `<ColorWheelFlower />` on its own, and the prose beside it
//                    says that is supported; it is not. The library's own
//                    `ColorWheel` wraps the same component in the provider.
//
// Both escape every boundary, and Solid 2 answers an escaped error by halting
// its reactive system for good, so the page paints once and then answers
// nothing. What is asserted here is that a person can reach them, which is
// true, and nothing about what they render, which is not.
[
    (
        id: "the-input-group-starts-from-a-page-that-clears-the-menu",
        group: "input",
        what: "the run reaches a route whose navigation resets the component disclosure",
        open: Some("Docs"),
        hover: None,
        click: None,
        subject: "heading:Quick Start",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-input-group-opens-the-component-menu",
        group: "input",
        what: "the component index offers its categories when asked",
        open: None,
        hover: None,
        click: Some("Components"),
        subject: "button:Input",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-input-group-selects-its-category",
        group: "input",
        what: "picking a category lists the pages under it",
        open: None,
        hover: None,
        click: Some("button:Input"),
        subject: "link:Radio Group",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-calendar-showcase-is-listed-and-reachable",
        group: "input",
        what: "the menu offers the calendar page, which is as far as this suite goes",
        open: None,
        hover: None,
        click: None,
        // Deliberately not opened. See the header: the page halts the engine.
        subject: "link:Calendar",
        expect: Enabled,
    ),
    (
        id: "the-colour-picker-showcase-is-listed-and-reachable",
        group: "input",
        what: "the menu offers the colour picker page, which is as far as this suite goes",
        open: None,
        hover: None,
        click: None,
        subject: "link:Color Picker",
        expect: Enabled,
    ),
    // Checkbox.
    (
        id: "the-checkbox-page-opens",
        group: "input",
        what: "the menu reaches the Checkbox showcase",
        open: None,
        hover: None,
        click: Some("link:Checkbox"),
        subject: "heading:Checkbox",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-checkbox-page-mounts-every-example",
        group: "input",
        what: "all six sections produced their inputs",
        open: None,
        hover: None,
        click: None,
        // One default, one controlled, one indeterminate, one form control,
        // two variants, two disabled.
        subject: "checkbox:",
        expect: Count,
        expect_count: Some(8),
    ),
    (
        id: "a-checkbox-in-a-form-control-carries-its-label",
        group: "input",
        what: "the labelled example is the one a screen reader can read",
        open: None,
        hover: None,
        click: None,
        // The only named checkbox on the page. Every other example leaves the
        // input anonymous, which is the reason the check above has to count.
        subject: "checkbox:Remember me",
        expect: Enabled,
    ),
    (
        id: "the-checkbox-page-covers-the-disabled-state",
        group: "input",
        what: "the section with no addressable control at least drew its heading",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Disabled States",
        expect: Present,
    ),
    // File Input.
    (
        id: "the-file-input-page-opens",
        group: "input",
        what: "the menu reaches the File Input showcase",
        open: None,
        hover: None,
        click: Some("link:File Input"),
        subject: "heading:File Input",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-file-input-is-a-labelled-field-with-a-browse-control",
        group: "input",
        what: "the recipe produced a named field rather than a bare native input",
        open: None,
        hover: None,
        click: None,
        // The field is as tall as its text and no taller: 874x0 with no font
        // catalogue. The claim worth keeping is that the recipe produced a
        // `textbox` carrying the label as its accessible name, which is what
        // `Present` asserts; a bare native input would fail it either way.
        subject: "textbox:Attachment",
        expect: Present,
    ),
    (
        id: "and-the-browse-control-beside-it",
        group: "input",
        what: "the affordance that opens the file dialog is there",
        open: None,
        hover: None,
        click: None,
        // `Enabled` is a painted assertion, and this control has no padding of
        // its own: it is the file input's own label, sized entirely by its
        // text, so it lays out at 0x0 without fonts. `Present` keeps the part
        // that survives -- a `button` named `Browse` exists beside the field.
        // The enabled state is the one thing this check loses on a fontless
        // host; nothing in the vocabulary reads it without geometry.
        subject: "button:Browse",
        expect: Present,
    ),
    // Form.
    (
        id: "the-form-page-opens",
        group: "input",
        what: "the menu reaches the Form showcase",
        open: None,
        hover: None,
        click: Some("link:Form"),
        subject: "heading:Form",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-form-page-labels-every-field",
        group: "input",
        what: "the two-column example named its fields rather than relying on placement",
        open: None,
        hover: None,
        click: None,
        subject: "textbox:First Name",
        expect: Paints,
    ),
    (
        id: "the-form-page-accepts-typing",
        group: "input",
        what: "a field takes input and the page survives it",
        open: None,
        hover: None,
        click: None,
        type_into: Some("textbox:Phone"),
        text: Some("+44 20 7946 0000"),
        // A halted reactive system paints its last frame and answers nothing,
        // so the question worth asking after typing is whether the rest of the
        // form is still alive.
        subject: "button:Continue",
        expect: Enabled,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-form-page-covers-schema-validation",
        group: "input",
        what: "the createForm and Zod example, which is the reason this page exists, rendered",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Validated Form (createForm + Zod)",
        expect: Present,
    ),
    (
        id: "and-that-form-has-a-submit",
        group: "input",
        what: "the validated example is a whole form rather than two fields",
        open: None,
        hover: None,
        click: None,
        subject: "textbox:Username",
        expect: Paints,
    ),
    // Input.
    (
        id: "the-input-page-opens",
        group: "input",
        what: "the menu reaches the Input showcase",
        open: None,
        hover: None,
        click: Some("link:Input"),
        subject: "textbox:Type here",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-input-page-shows-a-disabled-field",
        group: "input",
        what: "the disabled state refuses input rather than only looking pale",
        open: None,
        hover: None,
        click: None,
        subject: "textbox:Disabled state",
        expect: Disabled,
    ),
    (
        id: "and-an-enabled-field-beside-it",
        group: "input",
        what: "the disabled assertion is about state, not about a page that drew nothing",
        open: None,
        hover: None,
        click: None,
        subject: "textbox:Invalid state",
        expect: Enabled,
    ),
    (
        id: "the-input-page-keeps-its-size-scale",
        group: "input",
        what: "the large field is taller than the small one",
        open: None,
        hover: None,
        click: None,
        // Field heights come from the recipe's own tokens. A recipe that stops
        // resolving leaves all three at one height with three different labels.
        subject: "textbox:Large",
        expect: Measures,
        expect_size: Some("x22"),
    ),
    (
        id: "and-the-small-field-is-actually-smaller",
        group: "input",
        what: "the scale is a scale rather than one height with three labels",
        open: None,
        hover: None,
        click: None,
        subject: "textbox:Small",
        expect: Measures,
        expect_size: Some("x<=17"),
    ),
    (
        id: "the-input-page-covers-fields-with-icons",
        group: "input",
        what: "an icon inside the field leaves room for the text",
        open: None,
        hover: None,
        click: None,
        subject: "textbox:Password with icons",
        expect: Paints,
    ),
    // Radio Group.
    (
        id: "the-radio-group-page-opens",
        group: "input",
        what: "the menu reaches the Radio Group showcase",
        open: None,
        hover: None,
        click: Some("link:Radio Group"),
        subject: "heading:Radio Group",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-radio-group-page-groups-its-options",
        group: "input",
        what: "each example is a radiogroup rather than loose radios",
        open: None,
        hover: None,
        click: None,
        // The grouping is the accessibility contract: without it, arrow keys
        // do not move between options and a screen reader reads no set size.
        subject: "radiogroup:",
        expect: Count,
        expect_count: Some(7),
    ),
    (
        id: "and-names-its-options",
        group: "input",
        what: "an option carries its label, unlike the bare Radio page",
        open: None,
        hover: None,
        click: None,
        subject: "radio:Cherry",
        expect: Paints,
    ),
    (
        id: "the-radio-group-page-covers-the-invalid-state",
        group: "input",
        what: "the validation example rendered",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Invalid State",
        expect: Present,
    ),
    // Select. The one input on the site with a real open and close.
    (
        id: "the-select-page-opens",
        group: "input",
        what: "the menu reaches the Select showcase",
        open: None,
        hover: None,
        click: Some("link:Select"),
        subject: "heading:Select",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "a-select-has-no-options-until-it-is-opened",
        group: "input",
        what: "the listbox is built on demand rather than sitting open",
        open: None,
        hover: None,
        click: None,
        subject: "option:Mango",
        expect: Absent,
    ),
    (
        id: "and-its-trigger-is-there-to-press",
        group: "input",
        what: "the absence above is about the listbox rather than a page that drew nothing",
        open: None,
        hover: None,
        click: None,
        subject: "button:Select a fruit",
        expect: Enabled,
    ),
    (
        id: "and-pressing-it-lists-every-option",
        group: "input",
        what: "the trigger opens a listbox with the options it was given",
        open: None,
        hover: None,
        click: Some("button:Select a fruit"),
        // The last of six. Asserting the first would pass on a listbox that
        // rendered one option.
        subject: "option:Kiwi",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "and-escape-closes-it-again",
        group: "input",
        what: "the component honours the keyboard contract it claims",
        open: None,
        hover: None,
        click: None,
        key_on: Some("button:Select a fruit"),
        key: Some("Escape"),
        // Not `Absent`: a closed listbox keeps its options in the tree at their
        // last size, now hidden, so geometry alone calls a working component
        // broken.
        subject: "option:Kiwi",
        expect: Vanishes,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-select-page-shows-a-disabled-select",
        group: "input",
        what: "the disabled state refuses to open",
        open: None,
        hover: None,
        click: None,
        subject: "button:Disabled",
        expect: Disabled,
    ),
    (
        id: "and-an-enabled-select-beside-it",
        group: "input",
        what: "the disabled assertion is about state rather than a dead section",
        open: None,
        hover: None,
        click: None,
        subject: "button:Full width",
        expect: Enabled,
    ),
    // Slider.
    (
        id: "the-slider-page-opens",
        group: "input",
        what: "the menu reaches the Slider showcase",
        open: None,
        hover: None,
        click: Some("link:Slider"),
        subject: "heading:Slider",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-slider-carries-a-label",
        group: "input",
        what: "the one example on this page names what it controls",
        open: None,
        hover: None,
        click: None,
        subject: "slider:Volume",
        expect: Paints,
    ),
    // Textarea.
    (
        id: "the-textarea-page-opens",
        group: "input",
        what: "the menu reaches the Textarea showcase",
        open: None,
        hover: None,
        click: Some("link:Textarea"),
        subject: "heading:Textarea",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "a-textarea-is-taller-than-one-line",
        group: "input",
        what: "the multiline field resolved a row count rather than collapsing to an input",
        open: None,
        hover: None,
        click: None,
        subject: "textbox:Bio",
        expect: Measures,
        expect_size: Some("300x50"),
    ),
    (
        id: "the-textarea-page-shows-a-disabled-field",
        group: "input",
        what: "the disabled state refuses input",
        open: None,
        hover: None,
        click: None,
        subject: "textbox:Disabled textarea",
        expect: Disabled,
    ),
    (
        id: "and-a-full-width-one-beside-it",
        group: "input",
        what: "the full-width variant spans its container rather than its content",
        open: None,
        hover: None,
        click: None,
        subject: "textbox:Full width textarea",
        expect: Measures,
        expect_size: Some("800x50"),
    ),
]
