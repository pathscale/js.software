// The preamble, and the reason each page is reached with `click` rather than
// `open`, are both described in `actions.ron`.
//
// The Navigation category: Breadcrumb, Dock, Link, Navbar, Pagination, Tabs.
//
// Navigation components are the ones whose accessible structure carries the
// most weight, because a person using them without sight is navigating by that
// structure alone. So the assertions here are about roles and containment: a
// breadcrumb is a `navigation` with a name, a dock is a `toolbar`, a tab strip
// is a `tablist` whose panel is replaced when a tab is chosen.
[
    (
        id: "the-navigation-group-starts-from-a-page-that-clears-the-menu",
        group: "navigation",
        what: "the run reaches a route whose navigation resets the component disclosure",
        open: Some("Docs"),
        hover: None,
        click: None,
        subject: "heading:Quick Start",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-navigation-group-opens-the-component-menu",
        group: "navigation",
        what: "the component index offers its categories when asked",
        open: None,
        hover: None,
        click: Some("Components"),
        subject: "button:Navigation",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-navigation-group-selects-its-category",
        group: "navigation",
        what: "picking a category lists the pages under it",
        open: None,
        hover: None,
        click: Some("button:Navigation"),
        subject: "link:Breadcrumb",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    // Breadcrumb.
    (
        id: "the-breadcrumb-page-opens",
        group: "navigation",
        what: "the menu reaches the Breadcrumb showcase",
        open: None,
        hover: None,
        click: Some("link:Breadcrumb"),
        subject: "heading:Breadcrumb",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "a-breadcrumb-is-a-named-navigation-landmark",
        group: "navigation",
        what: "each example is a landmark a screen reader can jump to, not a row of links",
        open: None,
        hover: None,
        click: None,
        subject: "navigation:Breadcrumb",
        expect: Count,
        expect_count: Some(3),
    ),
    (
        id: "and-its-crumbs-run-left-to-right",
        group: "navigation",
        what: "the trail reads as a path rather than stacking",
        open: None,
        hover: None,
        click: None,
        subject: "link:Add Document",
        compare: Some("link:Documents"),
        expect: RightOf,
    ),
    // Dock.
    (
        id: "the-dock-page-opens",
        group: "navigation",
        what: "the menu reaches the Dock showcase",
        open: None,
        hover: None,
        click: Some("link:Dock"),
        subject: "heading:Dock",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "a-dock-is-a-toolbar",
        group: "navigation",
        what: "all four examples took the toolbar role",
        open: None,
        hover: None,
        click: None,
        subject: "toolbar:Actions",
        expect: Count,
        expect_count: Some(4),
    ),
    (
        id: "and-every-dock-item-is-a-square-target",
        group: "navigation",
        what: "an icon-only item keeps a hit area rather than shrinking to its glyph",
        open: None,
        hover: None,
        click: None,
        subject: "link:Favorites",
        expect: Measures,
        expect_size: Some("32x32"),
    ),
    (
        id: "and-every-dock-carries-the-same-four-items",
        group: "navigation",
        what: "the vertical, resized and container-less variants each drew a full set",
        open: None,
        hover: None,
        click: None,
        subject: "link:Account",
        expect: Count,
        expect_count: Some(4),
    ),
    // Link.
    (
        id: "the-link-page-opens",
        group: "navigation",
        what: "the menu reaches the Link showcase",
        open: None,
        hover: None,
        click: Some("link:Link"),
        subject: "heading:Link",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "a-link-with-an-href-is-a-link",
        group: "navigation",
        what: "the component produced an anchor rather than a styled span",
        open: None,
        hover: None,
        click: None,
        subject: "link:Take me to Google!",
        expect: Paints,
    ),
    (
        id: "the-link-page-covers-the-external-case",
        group: "navigation",
        what: "the example that opens elsewhere is on the page",
        open: None,
        hover: None,
        click: None,
        subject: "link:External link",
        expect: Paints,
    ),
    // Navbar. The busiest page in the category.
    (
        id: "the-navbar-page-opens",
        group: "navigation",
        what: "the menu reaches the Navbar showcase",
        open: None,
        hover: None,
        click: Some("link:Navbar"),
        subject: "heading:Navbar",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-navbar-page-mounts-every-example",
        group: "navigation",
        what: "every example drew its brand, so none of them failed to build",
        open: None,
        hover: None,
        click: None,
        subject: "link:Brand",
        expect: Count,
        expect_count: Some(11),
    ),
    (
        id: "a-navbar-can-carry-a-search-field",
        group: "navigation",
        what: "the search example produced a real field inside the bar",
        open: None,
        hover: None,
        click: None,
        subject: "textbox:Search",
        expect: Paints,
    ),
    (
        id: "and-an-avatar-at-its-end",
        group: "navigation",
        what: "the account corner rendered its image",
        open: None,
        hover: None,
        click: None,
        subject: "img:avatar",
        expect: Count,
        expect_count: Some(2),
    ),
    (
        id: "and-a-responsive-example-with-an-action",
        group: "navigation",
        what: "the last example on the page rendered",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Responsive",
        expect: Present,
    ),
    // Pagination.
    (
        id: "the-pagination-page-opens",
        group: "navigation",
        what: "the menu reaches the Pagination showcase",
        open: None,
        hover: None,
        click: Some("link:Pagination"),
        subject: "heading:Pagination",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "every-page-control-says-which-page-it-goes-to",
        group: "navigation",
        what: "the buttons are named for their destination rather than by their digit alone",
        open: None,
        hover: None,
        click: None,
        // Six in the default example, four in the short one, five in the
        // elided one and six in the disabled one.
        subject: "button:Go to page",
        expect: Count,
        expect_count: Some(21),
    ),
    (
        id: "and-a-long-range-is-elided-rather-than-drawn-in-full",
        group: "navigation",
        what: "a hundred pages produce a handful of controls, with the last one reachable",
        open: None,
        hover: None,
        click: None,
        subject: "button:Go to page 100",
        expect: Enabled,
    ),
    (
        id: "and-the-step-controls-are-named-too",
        group: "navigation",
        what: "previous and next carry labels rather than bare arrows",
        open: None,
        hover: None,
        click: None,
        subject: "button:Go to next page",
        expect: Count,
        expect_count: Some(4),
    ),
    // Tabs. The one component in this category with a state worth driving.
    (
        id: "the-tabs-page-opens",
        group: "navigation",
        what: "the menu reaches the Tabs showcase",
        open: None,
        hover: None,
        click: Some("link:Tabs"),
        subject: "heading:Tabs",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "each-tab-strip-is-a-tablist",
        group: "navigation",
        what: "all seven examples produced the container role that makes arrow keys work",
        open: None,
        hover: None,
        click: None,
        subject: "tablist:",
        expect: Count,
        expect_count: Some(7),
    ),
    (
        id: "and-choosing-a-tab-swaps-the-panel",
        group: "navigation",
        what: "the panel a person reads is replaced, not merely restyled",
        open: None,
        hover: None,
        click: Some("tab:Tab B"),
        // The panels are unnamed, and only one of the three is ever laid out,
        // so a count does not move when the selection does. Comparing which
        // node is painted is the question that does.
        subject: "tabpanel:",
        expect: FamilyChanges,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "and-the-vertical-strip-is-a-tablist-too",
        group: "navigation",
        what: "the orientation parameter does not cost the component its role",
        open: None,
        hover: None,
        click: None,
        subject: "tab:Vertical",
        expect: Paints,
    ),
]
