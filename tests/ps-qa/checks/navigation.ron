// The preamble, and the reason each page is reached with `click` rather than
// `open`, are both described in `actions.ron`.
//
// The Navigation category: Breadcrumb, Dock, Link, Navbar, Pagination, Tabs.
//
// Navigation components are the ones whose accessible structure carries the
// most weight, because a person using them without sight is navigating by that
// structure alone. So the assertions here are about roles and containment: a
// breadcrumb is a `navigation` with a name, a dock is a `toolbar`, a tab strip
// is a `tablist` whose panel is replaced when a tab is chosen.
[
    (
        id: "the-navigation-group-starts-from-a-page-that-clears-the-menu",
        group: "navigation",
        what: "the run reaches a route whose navigation resets the component disclosure",
        open: Some("Docs"),
        hover: None,
        click: None,
        subject: "heading:Quick Start",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-navigation-group-opens-the-component-menu",
        group: "navigation",
        what: "the component index offers its categories when asked",
        open: None,
        hover: None,
        click: Some("Components"),
        subject: "button:Navigation",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-navigation-group-selects-its-category",
        group: "navigation",
        what: "picking a category lists the pages under it",
        open: None,
        hover: None,
        click: Some("button:Navigation"),
        subject: "link:Breadcrumb",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    // Breadcrumb.
    (
        id: "the-breadcrumb-page-opens",
        group: "navigation",
        what: "the menu reaches the Breadcrumb showcase",
        open: None,
        hover: None,
        click: Some("link:Breadcrumb"),
        subject: "heading:Breadcrumb",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "a-breadcrumb-is-a-named-navigation-landmark",
        group: "navigation",
        what: "each example is a landmark a screen reader can jump to, not a row of links",
        open: None,
        hover: None,
        click: None,
        subject: "navigation:Breadcrumb",
        expect: Count,
        expect_count: Some(3),
    ),
    (
        id: "and-its-crumbs-hold-their-own-places",
        group: "navigation",
        what: "the crumbs hold their own places rather than stacking on one another",
        open: None,
        hover: None,
        click: None,
        // This was `link:Add Document` right of `link:Documents`, and it
        // cannot be that on a host with no font catalogue. The page draws the
        // same trail three times and the crumb names repeat across all three,
        // so the selector matches the plain example's anchors as well -- and
        // those are pure text, 4x0, while the icon example's are 28x16.
        // `RightOf` requires *every* match to paint, so the assertion fails on
        // the example whose links have nothing but a label.
        //
        // The list items are what survive: each one has a box in every
        // example, and `DistinctPositions` fails exactly when a trail collapses
        // onto one coordinate, which is the stacking this check is about. What
        // it no longer proves is the left-to-right order specifically.
        subject: "listitem:",
        expect: DistinctPositions,
    ),
    // Dock.
    (
        id: "the-dock-page-opens",
        group: "navigation",
        what: "the menu reaches the Dock showcase",
        open: None,
        hover: None,
        click: Some("link:Dock"),
        subject: "heading:Dock",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "a-dock-is-a-toolbar",
        group: "navigation",
        what: "all four examples took the toolbar role",
        open: None,
        hover: None,
        click: None,
        subject: "toolbar:Actions",
        expect: Count,
        expect_count: Some(4),
    ),
    (
        id: "and-every-dock-item-is-a-square-target",
        group: "navigation",
        what: "an icon-only item keeps a hit area rather than shrinking to its glyph",
        open: None,
        hover: None,
        click: None,
        subject: "link:Favorites",
        expect: Measures,
        expect_size: Some("32x32"),
    ),
    (
        id: "and-every-dock-carries-the-same-four-items",
        group: "navigation",
        what: "the vertical, resized and container-less variants each drew a full set",
        open: None,
        hover: None,
        click: None,
        subject: "link:Account",
        expect: Count,
        expect_count: Some(4),
    ),
    // Link.
    (
        id: "the-link-page-opens",
        group: "navigation",
        what: "the menu reaches the Link showcase",
        open: None,
        hover: None,
        click: Some("link:Link"),
        subject: "heading:Link",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "a-link-with-an-href-is-a-link",
        group: "navigation",
        what: "the component produced an anchor rather than a styled span",
        open: None,
        hover: None,
        click: None,
        // A bare anchor: no padding, no border, so its box is its text and it
        // is 0x0 without fonts. `Present` is the assertion this check was
        // always making anyway -- a styled span would not carry the `link`
        // role.
        subject: "link:Take me to Google!",
        expect: Present,
    ),
    (
        id: "the-link-page-covers-the-external-case",
        group: "navigation",
        what: "the example that opens elsewhere is on the page",
        open: None,
        hover: None,
        click: None,
        // Bare anchor again, and `Present` for the same reason.
        subject: "link:External link",
        expect: Present,
    ),
    // Navbar. The busiest page in the category.
    (
        id: "the-navbar-page-opens",
        group: "navigation",
        what: "the menu reaches the Navbar showcase",
        open: None,
        hover: None,
        click: Some("link:Navbar"),
        subject: "heading:Navbar",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-navbar-page-mounts-every-example",
        group: "navigation",
        what: "every example drew its brand, so none of them failed to build",
        open: None,
        hover: None,
        click: None,
        subject: "link:Brand",
        expect: Count,
        expect_count: Some(11),
    ),
    (
        id: "a-navbar-can-carry-a-search-field",
        group: "navigation",
        what: "the search example produced a real field inside the bar",
        open: None,
        hover: None,
        click: None,
        subject: "textbox:Search",
        expect: Paints,
    ),
    (
        id: "and-an-avatar-at-its-end",
        group: "navigation",
        what: "the account corner rendered its image",
        open: None,
        hover: None,
        click: None,
        subject: "img:avatar",
        expect: Count,
        expect_count: Some(2),
    ),
    (
        id: "and-a-responsive-example-with-an-action",
        group: "navigation",
        what: "the last example on the page rendered",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Responsive",
        expect: Present,
    ),
    // Pagination.
    (
        id: "the-pagination-page-opens",
        group: "navigation",
        what: "the menu reaches the Pagination showcase",
        open: None,
        hover: None,
        click: Some("link:Pagination"),
        subject: "heading:Pagination",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "every-page-control-says-which-page-it-goes-to",
        group: "navigation",
        what: "the buttons are named for their destination rather than by their digit alone",
        open: None,
        hover: None,
        click: None,
        // Six in the default example, four in the short one, five in the
        // elided one and six in the disabled one.
        subject: "button:Go to page",
        expect: Count,
        expect_count: Some(21),
    ),
    (
        id: "and-a-long-range-is-elided-rather-than-drawn-in-full",
        group: "navigation",
        what: "a hundred pages produce a handful of controls, with the last one reachable",
        open: None,
        hover: None,
        click: None,
        subject: "button:Go to page 100",
        expect: Enabled,
    ),
    (
        id: "and-the-step-controls-are-named-too",
        group: "navigation",
        what: "previous and next carry labels rather than bare arrows",
        open: None,
        hover: None,
        click: None,
        subject: "button:Go to next page",
        expect: Count,
        expect_count: Some(4),
    ),
    // Tabs. The one component in this category with a state worth driving.
    (
        id: "the-tabs-page-opens",
        group: "navigation",
        what: "the menu reaches the Tabs showcase",
        open: None,
        hover: None,
        click: Some("link:Tabs"),
        subject: "heading:Tabs",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "each-tab-strip-is-a-tablist",
        group: "navigation",
        what: "all seven examples produced the container role that makes arrow keys work",
        open: None,
        hover: None,
        click: None,
        subject: "tablist:",
        expect: Count,
        expect_count: Some(7),
    ),
    (
        id: "and-choosing-a-tab-swaps-the-panel",
        group: "navigation",
        what: "the panel a person reads is replaced, not merely restyled",
        open: None,
        hover: None,
        click: Some("tab:Tab B"),
        // The panels are unnamed, and only one of the three is ever laid out,
        // so a count does not move when the selection does. Comparing which
        // node is painted is the question that does.
        subject: "tabpanel:",
        expect: FamilyChanges,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "and-the-vertical-strip-is-a-tablist-too",
        group: "navigation",
        what: "the orientation parameter does not cost the component its role",
        open: None,
        hover: None,
        click: None,
        subject: "tab:Vertical",
        expect: Paints,
    ),

    (
        id: "the-dropdown-outcomes-reset-navigation",
        group: "navigation",
        what: "the placement checks start from a closed global component menu",
        open: Some("Docs"),
        hover: None,
        click: None,
        subject: "heading:Quick Start",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-dropdown-outcomes-open-components",
        group: "navigation",
        what: "the global component menu opens for the dropdown checks",
        open: None,
        hover: None,
        click: Some("Components"),
        subject: "button:Actions",
        expect: PaintsNamed,
    ),
    (
        id: "the-dropdown-outcomes-select-actions",
        group: "navigation",
        what: "the Actions category exposes Dropdown",
        open: None,
        hover: None,
        click: Some("button:Actions"),
        subject: "link:Dropdown",
        expect: PaintsNamed,
    ),
    (
        id: "the-dropdown-outcomes-open-the-page",
        group: "navigation",
        what: "the dropdown placement checks run on the Dropdown showcase",
        open: None,
        hover: None,
        click: Some("link:Dropdown"),
        subject: "heading:Dropdown",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    // Placement menus and multilevel navigation get direct outcomes.
    (
        id: "dropdown-left-placement-opens",
        group: "navigation",
        what: "the left placement trigger opens a visible menu",
        open: None,
        hover: None,
        click: Some("#left-placement--trigger"),
        subject: "menuitem:Item 1",
        expect: PaintsNamed,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "dropdown-left-placement-closes",
        group: "navigation",
        what: "Escape closes the left placement menu",
        open: None,
        prepare: Some("#left-placement--trigger"),
        hover: None,
        click: None,
        key: Some("Escape"),
        key_on: Some("#left-placement--trigger"),
        subject: "menuitem:Item 1",
        expect: Vanishes,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "dropdown-right-placement-opens",
        group: "navigation",
        what: "the right placement trigger opens a visible menu",
        open: None,
        hover: None,
        click: Some("#right-placement--trigger"),
        subject: "menuitem:Item 1",
        expect: PaintsNamed,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "dropdown-right-placement-closes",
        group: "navigation",
        what: "Escape closes the right placement menu",
        open: None,
        prepare: Some("#right-placement--trigger"),
        hover: None,
        click: None,
        key: Some("Escape"),
        key_on: Some("#right-placement--trigger"),
        subject: "menuitem:Item 1",
        expect: Vanishes,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "dropdown-top-placement-opens",
        group: "navigation",
        what: "the top placement trigger opens a visible menu",
        open: None,
        hover: None,
        click: Some("#top-placement--trigger"),
        subject: "menuitem:Item 1",
        expect: PaintsNamed,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "dropdown-top-placement-closes",
        group: "navigation",
        what: "Escape closes the top placement menu",
        open: None,
        prepare: Some("#top-placement--trigger"),
        hover: None,
        click: None,
        key: Some("Escape"),
        key_on: Some("#top-placement--trigger"),
        subject: "menuitem:Item 1",
        expect: Vanishes,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "dropdown-bottom-placement-opens",
        group: "navigation",
        what: "the bottom placement trigger opens a visible menu",
        open: None,
        hover: None,
        click: Some("#bottom-placement--trigger"),
        subject: "menuitem:Item 1",
        expect: PaintsNamed,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "dropdown-bottom-placement-closes",
        group: "navigation",
        what: "Escape closes the bottom placement menu",
        open: None,
        prepare: Some("#bottom-placement--trigger"),
        hover: None,
        click: None,
        key: Some("Escape"),
        key_on: Some("#bottom-placement--trigger"),
        subject: "menuitem:Item 1",
        expect: Vanishes,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-navbar-outcomes-reset-navigation",
        group: "navigation",
        what: "the multilevel checks start from a closed global component menu",
        open: Some("Docs"),
        hover: None,
        click: None,
        subject: "heading:Quick Start",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-navbar-outcomes-open-components",
        group: "navigation",
        what: "the global component menu opens for the navbar checks",
        open: None,
        hover: None,
        click: Some("Components"),
        subject: "button:Navigation",
        expect: PaintsNamed,
    ),
    (
        id: "the-navbar-outcomes-select-navigation",
        group: "navigation",
        what: "the Navigation category exposes Navbar",
        open: None,
        hover: None,
        click: Some("button:Navigation"),
        subject: "link:Navbar",
        expect: PaintsNamed,
    ),
    (
        id: "the-navbar-outcomes-open-the-page",
        group: "navigation",
        what: "the multilevel checks run on the Navbar showcase",
        open: None,
        hover: None,
        click: Some("link:Navbar"),
        subject: "heading:Navbar",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "navbar-trading-terminal-selects",
        group: "navigation",
        what: "the Trading Terminal navigation choice reports its active state",
        open: None,
        hover: None,
        click: Some("button:Trading Terminal"),
        subject: "button:Trading Terminal",
        expect: SelectionChanges,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "navbar-performance-selects",
        group: "navigation",
        what: "the Performance navigation choice reports its active state",
        open: None,
        hover: None,
        click: Some("button:Performance"),
        subject: "button:Performance",
        expect: SelectionChanges,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "navbar-funding-comparison-selects",
        group: "navigation",
        what: "the Funding Comparison navigation choice reports its active state",
        open: None,
        hover: None,
        click: Some("button:Funding Comparison"),
        subject: "button:Funding Comparison",
        expect: SelectionChanges,
        outcome_timeout_ms: 8000,
    ),

]
