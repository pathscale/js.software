// The public package manifest, the route registry and this page are one
// contract: every @pathscale/ui family has either a focused route or one of
// these real consumer compositions. These outcomes cover the families added
// to the lab as part of that contract; the focused-route groups cover the rest.
[
    (
        id: "coverage-starts-from-a-closed-menu",
        group: "coverage",
        what: "the coverage run starts from a stable surface",
        open: Some("Docs"), hover: None, click: None,
        subject: "heading:Quick Start", expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "coverage-opens-the-component-menu",
        group: "coverage",
        what: "the public component navigation opens",
        open: None, hover: None, click: Some("Components"),
        subject: "#component-category-surfaces", expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "coverage-opens-the-surfaces-category",
        group: "coverage",
        what: "the coverage lab is listed in the component navigation",
        open: None, hover: None, click: Some("#component-category-surfaces"),
        subject: "link:Complete Coverage", expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "coverage-opens-the-complete-public-gallery",
        group: "coverage",
        what: "the full gallery builds from the local UI package candidate",
        open: None, hover: None, click: Some("link:Complete Coverage"),
        subject: "heading:Complete Coverage", expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "coverage-address-copies",
        group: "coverage",
        what: "Address calls its owner with the copied value",
        open: None, hover: None, click: Some("button:Copy address"),
        subject: "status:Copied 0x1234567890abcdef", expect: Present,
    ),
    (
        id: "coverage-auth-email-accepts-input",
        group: "coverage",
        what: "the auth composition contains a real labelled email field",
        open: None, hover: None, click: None,
        type_into: Some("textbox:Email"), text: Some("qa@example.com"),
        subject: "textbox:Email", expect: ValueChanges,
    ),
    (
        id: "coverage-auth-submit-acts",
        group: "coverage",
        what: "AuthSubmitButton invokes the form owner",
        open: None, hover: None, click: Some("button:Sign in"),
        subject: "status:Sign in submitted", expect: Present,
    ),
    (
        id: "coverage-auth-privacy-acts",
        group: "coverage",
        what: "an AuthFooterLinks button invokes its item callback",
        open: None, hover: None, click: Some("button:Privacy"),
        subject: "status:Privacy opened", expect: Present,
        covers: ["button:Help"],
    ),
    (
        id: "coverage-field-group-input-acts",
        group: "coverage",
        what: "FieldGroup and Label preserve a field's accessible input contract",
        open: None, hover: None, click: None,
        type_into: Some("textbox:Grouped field"), text: Some("grouped value"),
        subject: "textbox:Grouped field", expect: ValueChanges,
    ),
    (
        id: "coverage-composer-accepts-input",
        group: "coverage",
        what: "Composer retains a controlled draft",
        open: None, hover: None, click: None,
        type_into: Some("textbox:Write a showcase message"), text: Some("Hello showcase"),
        subject: "textbox:Write a showcase message", expect: ValueChanges,
    ),
    (
        id: "coverage-composer-sends",
        group: "coverage",
        what: "Composer sends the draft to its owner",
        open: None, hover: None, click: Some("button:Send"),
        subject: "status:Sent Hello showcase", expect: Present,
    ),
    (
        id: "coverage-connection-settings-open",
        group: "coverage",
        what: "ConnectionSettings reveals its editable endpoint",
        open: None, hover: None, click: Some("switch:Use custom backend"),
        subject: "textbox:API URL", expect: Paints,
        covers: ["button:Save connection", "button:Reset connection"],
    ),
    (
        id: "coverage-standalone-swatch-acts",
        group: "coverage",
        what: "ColorSwatch reports the selected colour",
        open: None, hover: None, click: Some("option:Indigo swatch"),
        subject: "status:Selected #6366f1", expect: Present,
    ),
    (
        id: "coverage-swatch-picker-selects",
        group: "coverage",
        what: "ColorSwatchPicker changes its controlled selection",
        open: None, hover: None, click: Some("radio:Blue swatch"),
        subject: "radio:Blue swatch", expect: SelectionChanges,
    ),
    (
        id: "coverage-color-wheel-selects",
        group: "coverage",
        what: "the public ColorWheel reacts to a palette choice",
        open: None, hover: None, click: Some("radio:Reset to neutral"),
        subject: "radio:Reset to neutral", expect: SelectionChanges,
        covers: ["radio:Theme color *"],
    ),
    (
        id: "coverage-complex-wheel-adjusts",
        group: "coverage",
        what: "ComplexColorWheel changes an authored adjustment",
        open: None, hover: None, click: Some("button:Strength 20"),
        subject: "button:Strength 20", expect: SelectionChanges,
        covers: ["button:Strength *"],
    ),
    (
        id: "coverage-inline-edit-opens",
        group: "coverage",
        what: "InlineEdit exposes its editor on demand",
        open: None, hover: None, click: Some("button:Edit showcase title"),
        subject: "textbox:Edit showcase title", expect: Paints,
    ),
    (
        id: "coverage-panel-toggle-acts",
        group: "coverage",
        what: "PanelToggle updates its action name and controlled panel",
        open: None, hover: None, click: Some("button:Hide coverage panel"),
        subject: "button:Show coverage panel", expect: Paints,
    ),
    (
        id: "coverage-password-accepts-input",
        group: "coverage",
        what: "PasswordField controls the password and requirements",
        open: None, hover: None, click: None,
        type_into: Some("textbox:Coverage password"), text: Some("secret123"),
        subject: "textbox:Coverage password", expect: ValueChanges,
    ),
    (
        id: "coverage-password-reveals",
        group: "coverage",
        what: "PasswordField exposes its visibility action",
        open: None, hover: None, click: Some("button:Show password"),
        subject: "button:Hide password", expect: Paints,
    ),
    (
        id: "coverage-flex-grid-reveals-more",
        group: "coverage",
        what: "FlexGrid's explicit pagination builds the remaining row",
        open: None, hover: None, click: Some("button:Show 1 more"),
        subject: "text:Gamma", expect: Present,
    ),
    (
        id: "coverage-loads-live-chat-panel",
        group: "coverage",
        what: "the large LiveChatPanel specimen loads without taking the gallery down",
        open: None, hover: None, click: Some("button:Load LiveChatPanel"),
        subject: "heading:Component support", expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "coverage-live-chat-accepts-message",
        group: "coverage",
        what: "LiveChatPanel accepts a message",
        open: None, hover: None, click: None,
        type_into: Some("textbox:Message support..."), text: Some("Need help"),
        subject: "textbox:Message support...", expect: ValueChanges,
    ),
    (
        id: "coverage-live-chat-sends-message",
        group: "coverage",
        what: "LiveChatPanel hands the message to its owner",
        open: None, hover: None, click: Some("button:Send chat message"),
        subject: "status:Sent Need help", expect: Present,
    ),
    (
        id: "coverage-live-chat-closes",
        group: "coverage",
        what: "LiveChatPanel closes cleanly before the next overlay example",
        open: None, hover: None, click: Some("button:Close chat"),
        subject: "status:Chat closed", expect: Present,
    ),
    (
        id: "coverage-returns-from-live-chat",
        group: "coverage",
        what: "the fullscreen specimen returns to the complete gallery",
        open: None, hover: None, click: Some("button:Return to coverage"),
        subject: "button:Load LiveChatPanel", expect: Paints,
    ),
    (
        id: "coverage-loads-immersive-landing",
        group: "coverage",
        what: "ImmersiveLanding mounts its first real page",
        open: None, hover: None, click: Some("button:Load ImmersiveLanding"),
        subject: "heading:Introduction", expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "coverage-immersive-landing-navigates",
        group: "coverage",
        what: "ImmersiveLanding moves to its second page",
        open: None, hover: None, click: Some("button:Go to page 2 of 2"),
        subject: "heading:Details", expect: Present,
        covers: ["button:Go to page 1 of 2", "button:Next page"],
    ),
    (
        id: "coverage-returns-from-immersive-landing",
        group: "coverage",
        what: "the immersive specimen returns to the component gallery",
        open: None, hover: None, click: Some("button:Return to coverage"),
        subject: "button:Load ImmersiveLanding", expect: Paints,
    ),
    (
        id: "coverage-loads-cookie-consent",
        group: "coverage",
        what: "CookieConsent mounts its real choice surface",
        open: None, hover: None, click: Some("button:Load CookieConsent"),
        subject: "button:Manage coverage cookies", expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "coverage-cookie-consent-manages",
        group: "coverage",
        what: "CookieConsent opens preference management",
        open: None, hover: None, click: Some("button:Manage coverage cookies"),
        subject: "heading:Manage coverage cookie preferences", expect: Present,
        covers: ["button:Accept all coverage cookies", "button:Decline coverage cookies"],
    ),
    (
        id: "coverage-cookie-consent-saves",
        group: "coverage",
        what: "CookieConsent saves and dismisses its managed choice",
        open: None, hover: None, click: Some("button:Save coverage cookie preferences"),
        subject: "status:Cookie consent custom", expect: Present,
    ),
    (
        id: "coverage-returns-from-cookie-consent",
        group: "coverage",
        what: "the cookie specimen returns after saving",
        open: None, hover: None, click: Some("button:Return to coverage"),
        subject: "button:Load CookieConsent", expect: Paints,
    ),
    (
        id: "coverage-loads-pwa-prompt",
        group: "coverage",
        what: "PWAInstallPrompt receives the browser install event",
        open: None, hover: None, click: Some("button:Load PWAInstallPrompt"),
        subject: "button:Install showcase", expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "coverage-pwa-prompt-dismisses",
        group: "coverage",
        what: "PWAInstallPrompt reports a later choice and closes",
        open: None, hover: None, click: Some("button:Install later"),
        subject: "status:Install dismissed", expect: Present,
        covers: ["button:Install showcase", "button:Close install prompt"],
    ),
    (
        id: "coverage-returns-from-pwa-prompt",
        group: "coverage",
        what: "the PWA specimen returns after dismissal",
        open: None, hover: None, click: Some("button:Return to coverage"),
        subject: "button:Load PWAInstallPrompt", expect: Paints,
    ),
    (
        id: "coverage-loads-firefox-banner",
        group: "coverage",
        what: "FirefoxPWABanner mounts under a Firefox user agent",
        open: None, hover: None, click: Some("button:Load FirefoxPWABanner"),
        subject: "button:Install Firefox extension", expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "coverage-firefox-banner-dismisses",
        group: "coverage",
        what: "FirefoxPWABanner reports dismissal and closes",
        open: None, hover: None, click: Some("button:Maybe later"),
        subject: "status:Firefox prompt dismissed", expect: Present,
        covers: ["button:Install Firefox extension", "button:Close Firefox prompt"],
    ),
    (
        id: "coverage-returns-from-firefox-banner",
        group: "coverage",
        what: "the Firefox specimen returns after dismissal",
        open: None, hover: None, click: Some("button:Return to coverage"),
        subject: "button:Load FirefoxPWABanner", expect: Paints,
    ),
    (
        id: "coverage-button-group-acts",
        group: "coverage",
        what: "ButtonGroup carries controlled button outcomes",
        open: None, hover: None, click: Some("button:One"),
        subject: "status:Selected One", expect: Present,
        covers: ["button:Two"],
    ),
    (
        id: "coverage-checkbox-group-acts",
        group: "coverage",
        what: "CheckboxGroup contains operable labelled choices",
        open: None, hover: None, click: Some("checkbox:Second"),
        subject: "checkbox:Second", expect: SelectionChanges,
        covers: ["checkbox:First"],
    ),
    (
        id: "coverage-close-button-acts",
        group: "coverage",
        what: "CloseButton invokes its owner",
        open: None, hover: None, click: Some("button:Dismiss coverage notice"),
        subject: "status:Dismissed", expect: Present,
    ),
    (
        id: "coverage-collapsible-opens",
        group: "coverage",
        what: "Collapsible reveals its content",
        open: None, hover: None, click: Some("button:More"),
        subject: "text:Hidden until opened.", expect: Present,
    ),
    (
        id: "coverage-accordion-opens",
        group: "coverage",
        what: "Accordion reveals its content",
        open: None, hover: None, click: Some("button:First"),
        subject: "text:One.", expect: Present,
    ),
    (
        id: "coverage-grouped-input-accepts",
        group: "coverage",
        what: "the composed Input retains text before submission",
        open: None, hover: None, click: None,
        type_into: Some("textbox:Grouped input"), text: Some("grouped"),
        subject: "textbox:Grouped input", expect: ValueChanges,
    ),
    (
        id: "coverage-grouped-input-submits",
        group: "coverage",
        what: "the composed input action reports its current value",
        open: None, hover: None, click: Some("button:Go"),
        subject: "status:Submitted grouped", expect: Present,
    ),
    (
        id: "coverage-input-otp-accepts",
        group: "coverage",
        what: "InputOTP accepts a verification code in the public consumer",
        open: None, hover: None, click: None,
        type_into: Some("textbox:Coverage verification code"), text: Some("123456"),
        subject: "textbox:Coverage verification code", expect: ValueChanges,
    ),
    (
        id: "coverage-popover-opens",
        group: "coverage",
        what: "Popover opens its portalled content",
        open: None, hover: None, click: Some("button:Open"),
        subject: "text:Content.", expect: Present,
    ),
    (
        id: "coverage-size-picker-selects",
        group: "coverage",
        what: "SizePicker changes the selected preset",
        open: None, hover: None, click: Some("radio:Size L"),
        subject: "radio:Size L", expect: SelectionChanges,
        covers: ["radio:Size XL"],
    ),
    (
        id: "coverage-size-picker-restores-default",
        group: "coverage",
        what: "SizePicker restores the document scale before leaving the gallery",
        open: None, hover: None, click: Some("radio:Size M"),
        subject: "radio:Size M", expect: SelectionChanges,
    ),
    (
        id: "coverage-combobox-opens",
        group: "coverage",
        what: "ComboBox opens its alternatives",
        open: None, hover: None, click: Some("button:Toggle options"),
        subject: "option:Beta", expect: Paints,
    ),
    (
        id: "coverage-combobox-selects",
        group: "coverage",
        what: "ComboBox changes the selected option",
        open: None, hover: None, click: Some("option:Beta"),
        subject: "combobox:Coverage combo box", expect: ValueChanges,
    ),
    (
        id: "coverage-language-switcher-opens",
        group: "coverage",
        what: "LanguageSwitcher exposes its alternative locale",
        open: None, hover: None, click: Some("button:Current language: English"),
        subject: "menuitem:Espanol", expect: Paints,
    ),
    (
        id: "coverage-language-switcher-selects",
        group: "coverage",
        what: "LanguageSwitcher changes the current locale",
        open: None, hover: None, click: Some("menuitem:Espanol"),
        subject: "status:Language selected es", expect: Present,
    ),
    (
        id: "coverage-language-switcher-updates-trigger",
        group: "coverage",
        what: "LanguageSwitcher updates the visible current-language control",
        open: None, hover: None, click: None,
        subject: "button:Current language: Espanol", expect: Present,
    ),
    (
        id: "coverage-loads-live-chat-bubble",
        group: "coverage",
        what: "the fixed LiveChatBubble is reachable in a viewport-sized consumer",
        open: None, hover: None, click: Some("button:Load LiveChatBubble"),
        subject: "button:Open chat", expect: Present,
    ),
    (
        id: "coverage-live-chat-bubble-acts",
        group: "coverage",
        what: "LiveChatBubble invokes its open callback",
        open: None, hover: None, click: Some("button:Open chat"),
        subject: "status:Chat bubble opened", expect: Present,
    ),
    (
        id: "coverage-leaves-live-chat-bubble-through-navigation",
        group: "coverage",
        what: "normal navigation unmounts the fullscreen specimen cleanly",
        open: Some("Home"), hover: None, click: None,
        subject: "heading:Build Exceptional UIs", expect: Present,
    ),
    (
        id: "coverage-reopens-the-component-menu-after-fullscreen-navigation",
        group: "coverage",
        what: "the global component navigation still works after fullscreen teardown",
        open: None, hover: None, click: Some("Components"),
        subject: "#component-category-surfaces", expect: Paints,
    ),
    (
        id: "coverage-reopens-the-surfaces-category-after-fullscreen-navigation",
        group: "coverage",
        what: "the coverage route remains reachable after fullscreen teardown",
        open: None, hover: None, click: Some("#component-category-surfaces"),
        subject: "link:Complete Coverage", expect: Paints,
    ),
    (
        id: "coverage-reopens-after-fullscreen-navigation",
        group: "coverage",
        what: "restored document scrolling reaches the bottom of the coverage gallery",
        open: None, hover: None, click: Some("link:Complete Coverage"),
        subject: "button:Load LiveChatBubble", expect: Paints,
    ),
