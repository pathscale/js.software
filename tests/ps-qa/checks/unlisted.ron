// The six showcases that are in no category of the component menu: Fieldset,
// Fieldset Actions, Footer, Icon, Radio and Video Preview.
//
// They are routed, and they are linked -- from the showcase index, which lists
// every route rather than only the ones `navigationData.ts` knows about. So
// they are reachable, and this group reaches them the way a person would:
// through the index, back to the index, and on to the next one. Navigating
// straight to a URL would assert that a page renders while saying nothing about
// whether anyone can get to it.
//
// The index links are addressed by a phrase from the card rather than by the
// component's name. A card's accessible name is its component followed by its
// description, so `Fieldset` alone also matches `Fieldset Actions`, and `Radio`
// also matches `Radio Group`.
//
// Each card is pressed with `click` rather than reached with `open`, for the
// reason written out in `actions.ron`: these pages are not surfaces, so `open`
// confirms arrival by waiting for the check's own heading to paint, and a
// heading does not paint on a host with no font catalogue.
//
// This group runs last in the suite, after every category group, because the
// index it depends on is the one page whose content is derived from the route
// table: if a route is added and this group starts failing, the route table and
// the component menu have gone out of step, and that is worth being told.
[
    (
        id: "the-unlisted-group-starts-from-the-showcase-index",
        group: "unlisted",
        what: "the index that lists every route, including the ones the menu omits, is reachable",
        open: Some("Showcases"),
        hover: None,
        click: None,
        subject: "heading:Component Showcases",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-index-lists-more-routes-than-the-component-menu",
        group: "unlisted",
        what: "a showcase absent from every category still has a card here",
        open: None,
        hover: None,
        click: None,
        subject: "link:Icon Consistent SVG icon presentation",
        expect: Enabled,
    ),
    // Fieldset.
    (
        id: "the-fieldset-page-opens-from-the-index",
        group: "unlisted",
        what: "the index card reaches the Fieldset showcase",
        open: None,
        hover: None,
        click: Some("link:Fieldset Related form controls"),
        subject: "heading:Default with Legend",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "a-fieldset-groups-its-fields",
        group: "unlisted",
        what: "the legend example produced its three named fields",
        open: None,
        hover: None,
        click: None,
        subject: "textbox:Last name",
        expect: Paints,
    ),
    (
        id: "and-a-fieldset-can-group-checkboxes",
        group: "unlisted",
        what: "the description example named each of its options",
        open: None,
        hover: None,
        click: None,
        subject: "checkbox:Push notifications",
        expect: Paints,
    ),
    (
        id: "and-a-fieldset-repeats-cleanly-at-three-gaps",
        group: "unlisted",
        what: "the custom-gap example built all three of its fieldsets",
        open: None,
        hover: None,
        click: None,
        // Three fieldsets of two fields each, one per gap value. The pairs
        // stack rather than sitting side by side, which is what the component
        // does here and not something this check is asserting either way.
        subject: "textbox:Field A",
        expect: Count,
        expect_count: Some(3),
    ),
    // Fieldset Actions.
    (
        id: "the-index-is-reachable-again-from-a-showcase",
        group: "unlisted",
        what: "the header returns to the index, which is how this group moves between pages",
        open: None,
        hover: None,
        click: Some("link:Showcases"),
        subject: "heading:Component Showcases",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-fieldset-actions-page-opens-from-the-index",
        group: "unlisted",
        what: "the index card reaches the Fieldset Actions showcase",
        open: None,
        hover: None,
        click: Some("link:Fieldset Actions Semantic form action layout"),
        subject: "button:Save changes",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "form-actions-put-the-primary-action-last",
        group: "unlisted",
        what: "confirm sits to the right of cancel, which is the whole content of this page",
        open: None,
        hover: None,
        click: None,
        subject: "button:Save changes",
        compare: Some("button:Cancel"),
        expect: RightOf,
    ),
    (
        id: "and-the-two-share-a-centre-line",
        group: "unlisted",
        what: "the action row is a row rather than two buttons that happen to be adjacent",
        open: None,
        hover: None,
        click: None,
        subject: "button:Save changes",
        compare: Some("button:Cancel"),
        expect: CenterAlignedY,
    ),
    // Footer.
    (
        id: "the-index-is-reachable-from-the-fieldset-actions-page",
        group: "unlisted",
        what: "the header returns to the index",
        open: None,
        hover: None,
        click: Some("link:Showcases"),
        subject: "heading:Component Showcases",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-footer-page-opens-from-the-index",
        group: "unlisted",
        what: "the index card reaches the Footer showcase",
        open: None,
        hover: None,
        click: Some("link:Footer Page footer structure"),
        subject: "heading:Centered Layout",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "a-footer-titles-its-columns",
        group: "unlisted",
        what: "the title part rendered in the examples that use it",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Company",
        expect: Count,
        expect_count: Some(2),
    ),
    (
        id: "and-the-vertical-example-rendered-too",
        group: "unlisted",
        what: "the layouts section produced each of its arrangements",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Vertical Layout",
        expect: Present,
    ),
    // Icon.
    (
        id: "the-index-is-reachable-from-the-footer-page",
        group: "unlisted",
        what: "the header returns to the index",
        open: None,
        hover: None,
        click: Some("link:Showcases"),
        subject: "heading:Component Showcases",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-icon-page-opens-from-the-index",
        group: "unlisted",
        what: "the index card reaches the Icon showcase",
        open: None,
        hover: None,
        click: Some("link:Icon Consistent SVG icon presentation"),
        subject: "heading:Custom Color",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-icon-page-covers-size-as-well-as-colour",
        group: "unlisted",
        what: "both parameters have their own example",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Custom Size",
        expect: Present,
    ),
    // Radio.
    (
        id: "the-index-is-reachable-from-the-icon-page",
        group: "unlisted",
        what: "the header returns to the index",
        open: None,
        hover: None,
        click: Some("link:Showcases"),
        subject: "heading:Component Showcases",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-radio-page-opens-from-the-index",
        group: "unlisted",
        what: "the index card reaches the bare Radio showcase",
        open: None,
        hover: None,
        click: Some("link:Radio Single-choice controls"),
        subject: "radio:Monthly",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-radio-page-mounts-every-example",
        group: "unlisted",
        what: "all five sections produced their inputs",
        open: None,
        hover: None,
        click: None,
        subject: "radio:",
        expect: Count,
        expect_count: Some(10),
    ),
    (
        id: "a-labelled-radio-carries-its-label",
        group: "unlisted",
        what: "the controlled example names its options, unlike the bare default one",
        open: None,
        hover: None,
        click: None,
        subject: "radio:Monthly",
        expect: Paints,
    ),
    (
        id: "and-a-radio-can-carry-a-description-too",
        group: "unlisted",
        what: "the description reaches the accessible name rather than sitting beside it",
        open: None,
        hover: None,
        click: None,
        subject: "radio:AnnualBilled once a year.",
        expect: Paints,
    ),
    // Video Preview.
    (
        id: "the-index-is-reachable-from-the-radio-page",
        group: "unlisted",
        what: "the header returns to the index",
        open: None,
        hover: None,
        click: Some("link:Showcases"),
        subject: "heading:Component Showcases",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-video-preview-page-opens-from-the-index",
        group: "unlisted",
        what: "the index card reaches the Video Preview showcase",
        open: None,
        hover: None,
        click: Some("link:Video Preview Live media preview"),
        subject: "button:Start Camera",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-video-preview-page-waits-to-be-asked-for-a-camera",
        group: "unlisted",
        what: "both examples offer a control rather than opening a device on load",
        open: None,
        hover: None,
        click: None,
        // Deliberately not pressed. There is no camera on a CI runner, and a
        // check that asked for one would be asserting something about the
        // machine rather than about the site.
        subject: "button:Start Camera",
        expect: Count,
        expect_count: Some(2),
    ),
    (
        id: "and-it-covers-the-mirrored-variant",
        group: "unlisted",
        what: "the second example rendered",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Mirror Mode",
        expect: Present,
    ),
]
