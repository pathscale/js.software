// The showcase, driven against its built output through a headless browser.
//
// This site is the library's kitchen sink, so what it proves is that the
// published `@pathscale/ui` renders in a real engine at all. A version that
// fails to boot takes the whole showcase with it, and the symptom is a blank
// page rather than an error anyone reads.
//
// The heading checks are `Present` rather than `Paints`: text is exactly as
// wide as its line and as tall as its shaped glyphs, so on a host with no font
// catalogue -- which a Linux runner is -- it lays out flat and a box assertion
// fails for a reason that says nothing about the site.
[
    (
        id: "the-showcase-renders",
        group: "showcase",
        what: "the showcase paints its heading rather than a blank page",
        open: Some("Home"),
        hover: None,
        click: None,
        subject: "heading:Build Exceptional UIs",
        expect: Present,
    ),
    (
        id: "the-navigation-is-there",
        group: "showcase",
        what: "the documentation is reachable from the home page",
        open: Some("Home"),
        hover: None,
        click: None,
        subject: "link:Docs",
        expect: Paints,
    ),
    (
        id: "the-component-menu-has-a-trigger",
        group: "showcase",
        what: "the component index is offered as something a person can press",
        open: Some("Home"),
        hover: None,
        click: None,
        subject: "button:Components",
        expect: Paints,
    ),
    (
        id: "the-body-rendered-too",
        group: "showcase",
        what: "the sections below the header rendered rather than only the shell",
        open: Some("Home"),
        hover: None,
        click: None,
        subject: "heading:Modern Components",
        expect: Present,
    ),
    // Everything above only asks whether the page painted, and a page that
    // paints can still be dead: Solid 2 halts the reactive system permanently
    // when an error escapes every boundary, and a halted page renders once
    // and then answers nothing. Pressing the menu and reading back what
    // appeared is what separates the two.
    //
    // The categories are the right subject rather than the trigger, because
    // the trigger is there either way. They exist only once the menu is open.
    (
        id: "the-component-menu-opens",
        group: "showcase",
        what: "pressing the trigger reveals the component categories",
        open: Some("Home"),
        hover: None,
        click: Some("Components"),
        subject: "button:Data display",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-menu-lists-more-than-one-category",
        group: "showcase",
        what: "the menu is a list of sections rather than a single entry",
        open: Some("Home"),
        hover: None,
        click: None,
        subject: "button:Navigation",
        expect: Paints,
    ),
    (
        id: "the-theming-page-is-reachable",
        group: "showcase",
        what: "the navigation reaches the theme editor rather than staying put",
        open: Some("Theming"),
        hover: None,
        click: None,
        subject: "heading:Theme Editor",
        expect: Present,
        outcome_timeout_ms: 3000,
    ),
    (
        id: "the-docs-are-reachable",
        group: "showcase",
        what: "the navigation reaches the documentation",
        open: Some("Docs"),
        hover: None,
        click: None,
        subject: "heading:Quick Start",
        expect: Present,
        outcome_timeout_ms: 3000,
    ),
    (
        id: "the-layouts-page-is-reachable",
        group: "showcase",
        what: "the documentation's own navigation reaches the layouts page",
        open: None,
        hover: None,
        click: Some("link:Layouts"),
        subject: "heading:The two compiler passes",
        expect: Present,
        outcome_timeout_ms: 3000,
    ),
    (
        id: "the-showcases-page-is-reachable",
        group: "showcase",
        what: "the navigation reaches the component showcases",
        open: Some("Showcases"),
        hover: None,
        click: None,
        subject: "heading:Component Showcases",
        expect: Present,
        outcome_timeout_ms: 3000,
    ),
    (
        id: "the-logo-goes-home",
        group: "showcase",
        what: "the header's own name is a link back to the landing page",
        open: Some("Showcases"),
        hover: None,
        click: Some("Home"),
        subject: "heading:Build Exceptional UIs",
        expect: Present,
        outcome_timeout_ms: 3000,
    ),
    // The landing page's own content. Everything above is about the header,
    // which is the same on every route; these are the four calls to action the
    // page exists to offer and the two card rows below them.
    //
    // A `Button` with an `href` is rendered as a link rather than a button, and
    // asserting that is the point of naming the role here: it is the difference
    // between a control a person can open in a new tab and one they cannot.
    (
        id: "the-landing-page-offers-its-primary-call-to-action",
        group: "showcase",
        what: "the hero's first action is a link, so it can be opened however a person likes",
        open: Some("Home"),
        hover: None,
        click: None,
        subject: "link:Start Building Today",
        expect: Paints,
    ),
    (
        id: "and-three-more-beside-it",
        group: "showcase",
        what: "the hero row rendered to its end rather than stopping at the primary action",
        open: Some("Home"),
        hover: None,
        click: None,
        subject: "link:How Layouts work",
        expect: Paints,
    ),
    (
        id: "and-they-sit-in-one-row",
        group: "showcase",
        what: "the call-to-action row is a row rather than a stack",
        open: Some("Home"),
        hover: None,
        click: None,
        subject: "link:How Layouts work",
        compare: Some("link:Start Building Today"),
        expect: RightOf,
    ),
    (
        id: "the-landing-page-draws-its-feature-cards",
        group: "showcase",
        what: "the three feature cards mounted, each as one control carrying its whole text",
        open: Some("Home"),
        hover: None,
        click: None,
        subject: "article:Developer Friendly",
        expect: Paints,
    ),
    (
        id: "and-a-second-row-of-them",
        group: "showcase",
        what: "the section below the features rendered too",
        open: Some("Home"),
        hover: None,
        click: None,
        subject: "article:Accessibility",
        expect: Paints,
    ),
    (
        id: "and-those-cards-are-full-height-rather-than-collapsed",
        group: "showcase",
        what: "a card resolved its padding rather than shrinking onto its heading",
        open: Some("Home"),
        hover: None,
        click: None,
        subject: "article:Accessibility",
        expect: Measures,
        // The height floor is the card's padding, not its text. With a font
        // catalogue this card resolves past 100px because its description
        // wraps; with none it is 46px, which is the padding and the border and
        // nothing else. 40 is the number that still fails a card that shrank
        // onto its heading -- that card would be 0 -- and passes on both kinds
        // of host. The width is the real half of the assertion anyway: a
        // collapsed card is not 300 wide.
        expect_size: Some("300x40"),
    ),
    (
        id: "the-landing-page-closes-with-a-second-invitation",
        group: "showcase",
        what: "the final section rendered, which a page that stopped halfway would not have",
        open: Some("Home"),
        hover: None,
        click: None,
        subject: "link:Get started for free",
        expect: Paints,
    ),
    (
        id: "and-the-hero-action-reaches-the-installation-guide",
        group: "showcase",
        what: "the first thing the page asks a person to press goes where it says",
        open: Some("Home"),
        hover: None,
        click: Some("link:Start Building Today"),
        subject: "heading:Required Dependencies",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
]
