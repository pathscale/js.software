// The showcase, driven against its built output through a headless browser.
//
// This site is the library's kitchen sink, so what it proves is that the
// published `@pathscale/ui` renders in a real engine at all. A version that
// fails to boot takes the whole showcase with it, and the symptom is a blank
// page rather than an error anyone reads.
//
// The heading checks are `Present` rather than `Paints`: text is exactly as
// wide as its line and as tall as its shaped glyphs, so on a host with no font
// catalogue -- which a Linux runner is -- it lays out flat and a box assertion
// fails for a reason that says nothing about the site.
[
    (
        id: "the-showcase-renders",
        group: "showcase",
        what: "the showcase paints its heading rather than a blank page",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Build Exceptional UIs",
        expect: Present,
    ),
    (
        id: "the-navigation-is-there",
        group: "showcase",
        what: "the documentation is reachable from the home page",
        open: None,
        hover: None,
        click: None,
        subject: "link:Docs",
        expect: Paints,
    ),
    (
        id: "the-component-menu-has-a-trigger",
        group: "showcase",
        what: "the component index is offered as something a person can press",
        open: None,
        hover: None,
        click: None,
        subject: "button:Components",
        expect: Paints,
    ),
    (
        id: "the-body-rendered-too",
        group: "showcase",
        what: "the sections below the header rendered rather than only the shell",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Modern Components",
        expect: Present,
    ),
    // Everything above only asks whether the page painted, and a page that
    // paints can still be dead: Solid 2 halts the reactive system permanently
    // when an error escapes every boundary, and a halted page renders once
    // and then answers nothing. Pressing the menu and reading back what
    // appeared is what separates the two.
    //
    // The categories are the right subject rather than the trigger, because
    // the trigger is there either way. They exist only once the menu is open.
    (
        id: "the-component-menu-opens",
        group: "showcase",
        what: "pressing the trigger reveals the component categories",
        open: None,
        hover: None,
        click: Some("Components"),
        subject: "button:Data display",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-menu-lists-more-than-one-category",
        group: "showcase",
        what: "the menu is a list of sections rather than a single entry",
        open: None,
        hover: None,
        click: None,
        subject: "button:Navigation",
        expect: Paints,
    ),
]
