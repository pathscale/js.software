// The controlled calendar starts in June 2025. Verify formatted dates,
// selection changes, and replacement of the grid when its month changes.
[
    // The preamble. `input.ron` reaches this link and stops; this group is the
    // one that presses it.
    (
        id: "the-calendar-group-starts-from-a-page-that-clears-the-menu",
        group: "calendar",
        what: "the run reaches a route whose navigation resets the component disclosure",
        open: Some("Docs"),
        hover: None,
        click: None,
        subject: "heading:Quick Start",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-calendar-group-opens-the-component-menu",
        group: "calendar",
        what: "the component index offers its categories when asked",
        open: None,
        hover: None,
        click: Some("Components"),
        subject: "button:Input",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-calendar-group-selects-its-category",
        group: "calendar",
        what: "picking a category lists the pages under it",
        open: None,
        hover: None,
        click: Some("button:Input"),
        subject: "link:Calendar",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-calendar-page-opens",
        group: "calendar",
        what: "the calendar showcase mounts rather than taking the application down",
        open: None,
        hover: None,
        click: Some("link:Calendar"),
        // The page title, from `ShowcaseLayout`'s `h1`. This is the first
        // thing that fails today: the throw happens during the first render,
        // so the heading never reaches the tree either.
        subject: "heading:Calendar",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-calendar-mounted-five-examples",
        group: "calendar",
        what: "every calendar on the page rendered a grid rather than the page rendering one and dying",
        open: None,
        hover: None,
        click: None,
        // Default, Controlled Value, Range Selection, Disabled, Min / Max.
        //
        // Addressed by slot rather than by role, because a subject with no
        // colon in it is a *name* pattern: `"grid"` asks for nodes whose
        // accessible name contains "grid", and the calendar's grids have no
        // name at all. `@calendar-grid` is the `data-slot` the component
        // writes, and it is the only way to count a family whose members are
        // anonymous.
        subject: "@calendar-grid",
        expect: Count,
        expect_count: Some(5),
    ),
    (
        id: "the-calendar-rendered-its-weekday-header-row",
        group: "calendar",
        what: "each calendar laid out seven column headers",
        open: None,
        hover: None,
        click: None,
        // Seven per calendar, five calendars. What these headers *say* cannot
        // be read from here -- see the header of this file -- so this only
        // says the row exists. Derived from the page rather than measured,
        // because the page cannot be opened until `Intl` exists: confirm the
        // number on the first run that gets this far.
        subject: "@calendar-header-cell",
        expect: Count,
        expect_count: Some(35),
    ),
    (
        id: "the-calendar-laid-out-its-month-heading",
        group: "calendar",
        what: "the heading the month formatter writes into occupies a box",
        open: None,
        hover: None,
        click: None,
        // The weakest check in the file, and it is here to mark the gap
        // rather than to close it. It says the heading node exists and was
        // laid out; it cannot say the node contains "June 2025", because a
        // bare `div` has no accessible name. Once `@pathscale/ui` gives that
        // element a role or a label, replace this with
        // `heading:June 2025` / `Present`, which is the check this file
        // actually wants.
        subject: "@calendar-heading",
        expect: Count,
        expect_count: Some(5),
    ),
    // The formatted strings. Each of these is the exact output of
    // `new Intl.DateTimeFormat("en-US", { dateStyle: "full" }).format(date)`,
    // and each names a cell of the Controlled Value calendar.
    //
    // A `String(value)` shim fails all four. So does `Invalid Date`. So does
    // any locale data that abbreviates the weekday or the month, or that puts
    // the day before the month.
    (
        id: "the-calendar-labels-the-first-day-of-its-month",
        group: "calendar",
        what: "the grid's first cell carries the full date its locale spells out",
        open: None,
        hover: None,
        click: None,
        subject: "gridcell:Sunday, June 1, 2025",
        expect: Paints,
    ),
    (
        id: "the-calendar-labels-its-selected-day",
        group: "calendar",
        what: "the day the example selects is the one the formatter names",
        open: None,
        hover: None,
        click: None,
        subject: "gridcell:Sunday, June 15, 2025",
        expect: Paints,
    ),
    (
        id: "the-calendar-labels-the-last-day-of-its-month",
        group: "calendar",
        what: "formatting held to the end of the month rather than only its first row",
        open: None,
        hover: None,
        click: None,
        subject: "gridcell:Monday, June 30, 2025",
        expect: Paints,
    ),
    (
        id: "the-calendar-labels-its-trailing-outside-days",
        group: "calendar",
        what: "the grid is a full six weeks and the days past the month are formatted too",
        open: None,
        hover: None,
        click: None,
        // 12 July 2025 is the forty-second cell of a grid that starts on
        // Sunday 1 June. A calendar that stopped at the month boundary, or
        // that formatted only the days it considers its own, fails here.
        subject: "gridcell:Saturday, July 12, 2025",
        expect: Paints,
    ),
    // Reactivity. Everything above is satisfied by a page that rendered once
    // and then halted, which is exactly the failure this whole exercise is
    // about: Solid 2 keeps painting the frame it already had. Driving the
    // calendar and reading back what changed is what separates a live page
    // from a corpse holding its pose.
    (
        id: "the-calendar-answers-a-click-on-a-day",
        group: "calendar",
        what: "pressing a day moves the selection, so the reactive system is still running",
        open: None,
        prepare: Some("link:Controlled Value"),
        hover: None,
        click: Some("gridcell:Tuesday, June 24, 2025"),
        subject: "gridcell:Tuesday, June 24, 2025",
        expect: SelectionChanges,
        outcome_timeout_ms: 8000,
    ),
    // Navigation is last, because it replaces every name above.
    //
    // Pressing an outside day moves the visible month to the month that day
    // belongs to. That re-runs the formatter over forty-two new dates, which
    // is the part worth proving: `Intl` has to work on every render, not only
    // on the first one, and a formatter memoised into a halted graph will not
    // produce a single new string.
    (
        id: "the-calendar-reformats-when-the-month-changes",
        group: "calendar",
        what: "moving to July produces August's outside days, formatted",
        open: None,
        prepare: Some("link:Controlled Value"),
        hover: None,
        // The July grid runs Sunday 29 June to Saturday 9 August 2025.
        click: Some("gridcell:Saturday, July 12, 2025"),
        subject: "gridcell:Friday, August 1, 2025",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-calendar-left-the-month-it-came-from",
        group: "calendar",
        what: "the June cells are gone rather than the new month being drawn over them",
        open: None,
        hover: None,
        click: None,
        // 1 June is not in the July grid, which starts on 29 June. A page that
        // painted July without discarding June would keep this cell.
        //
        // Absence is satisfied by a page that renders nothing, so this one
        // passes today and will pass on any broken calendar. It is worth
        // keeping anyway, for the one thing it does catch -- a grid that
        // accumulates months instead of replacing them -- but it is only
        // evidence at all once every check above it is green. Do not read a
        // pass here on its own.
        subject: "gridcell:Sunday, June 1, 2025",
        expect: Absent,
    ),
]
