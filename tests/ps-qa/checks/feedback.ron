// The Feedback category: Alert, Progress, Radial Progress, Skeleton, Spinner,
// Toast, Tooltip.
//
// These components exist to tell a person something, so what they are judged on
// here is mostly their *roles* rather than their boxes. `status` and `alert` are
// not styling: they decide whether a screen reader announces a message politely
// or interrupts with it, and the Alert page is the one place on the site where
// both are rendered side by side and the choice can be checked.
[
    (
        id: "the-feedback-group-starts-from-a-page-that-clears-the-menu",
        group: "feedback",
        what: "the run reaches a route whose navigation resets the component disclosure",
        open: Some("Docs"),
        hover: None,
        click: None,
        subject: "heading:Quick Start",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-feedback-group-opens-the-component-menu",
        group: "feedback",
        what: "the component index offers its categories when asked",
        open: None,
        hover: None,
        click: Some("Components"),
        subject: "button:Feedback",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-feedback-group-selects-its-category",
        group: "feedback",
        what: "picking a category lists the pages under it",
        open: None,
        hover: None,
        click: Some("button:Feedback"),
        subject: "link:Radial Progress",
        expect: Paints,
        outcome_timeout_ms: 8000,
    ),
    // Alert.
    (
        id: "the-alert-page-opens",
        group: "feedback",
        what: "the menu reaches the Alert showcase",
        open: Some("link:Alert"),
        hover: None,
        click: None,
        subject: "heading:Alert",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "an-informational-alert-is-a-status-region",
        group: "feedback",
        what: "an ordinary message is announced politely rather than as an interruption",
        open: None,
        hover: None,
        click: None,
        subject: "status:12 unread messages",
        expect: Paints,
    ),
    (
        id: "and-a-warning-is-an-alert-region",
        group: "feedback",
        what: "the severe flavours take the interrupting role, which is the whole point of the distinction",
        open: None,
        hover: None,
        click: None,
        subject: "alert:Warning status alert",
        expect: Paints,
    ),
    (
        id: "and-so-is-a-danger",
        group: "feedback",
        what: "the split is by severity rather than one flavour being special",
        open: None,
        hover: None,
        click: None,
        subject: "alert:Danger status alert",
        expect: Paints,
    ),
    (
        id: "and-a-success-stays-polite",
        group: "feedback",
        what: "a good-news message does not interrupt",
        open: None,
        hover: None,
        click: None,
        subject: "status:Success status alert",
        expect: Paints,
    ),
    (
        id: "an-alert-can-carry-its-own-actions",
        group: "feedback",
        what: "the consent example rendered both of its buttons inside the region",
        open: None,
        hover: None,
        click: None,
        subject: "button:Deny",
        expect: Paints,
    ),
    (
        id: "and-the-second-of-them",
        group: "feedback",
        what: "the action row rendered to its end",
        open: None,
        hover: None,
        click: None,
        subject: "button:Accept",
        expect: Enabled,
    ),
    // Progress and Radial Progress. Two components, one contract: a bar that
    // reports a value. Both draw their progressbars with no accessible name,
    // which is recorded here as a count rather than asserted as a name.
    (
        id: "the-progress-page-opens",
        group: "feedback",
        what: "the menu reaches the Progress showcase",
        open: Some("link:Progress"),
        hover: None,
        click: None,
        subject: "heading:Progress",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-progress-page-draws-its-bars",
        group: "feedback",
        what: "all three examples mounted a progressbar",
        open: None,
        hover: None,
        click: None,
        subject: "progressbar:",
        expect: Count,
        expect_count: Some(3),
    ),
    (
        id: "and-a-bar-is-wide-and-thin-rather-than-collapsed",
        group: "feedback",
        what: "the bar resolved a track height rather than laying out flat",
        open: None,
        hover: None,
        click: None,
        subject: "progressbar:",
        expect: Measures,
        expect_size: Some("400x8"),
    ),
    (
        id: "the-radial-progress-page-opens",
        group: "feedback",
        what: "the menu reaches the Radial Progress showcase",
        open: Some("link:Radial Progress"),
        hover: None,
        click: None,
        subject: "heading:Radial Progress",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-radial-progress-page-draws-round-bars",
        group: "feedback",
        what: "the circular form is square in its box, which is how it comes out round",
        open: None,
        hover: None,
        click: None,
        subject: "progressbar:",
        expect: Measures,
        expect_size: Some("24x24"),
    ),
    // Skeleton and Spinner: the two loading affordances.
    (
        id: "the-skeleton-page-opens",
        group: "feedback",
        what: "the menu reaches the Skeleton showcase",
        open: Some("link:Skeleton"),
        hover: None,
        click: None,
        subject: "heading:Skeleton",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-skeleton-page-covers-both-shapes",
        group: "feedback",
        what: "the circular and rectangular placeholders both have examples",
        open: None,
        hover: None,
        click: None,
        subject: "heading:Circle With Content",
        expect: Present,
    ),
    (
        id: "the-spinner-page-opens",
        group: "feedback",
        what: "the menu reaches the Spinner showcase",
        open: Some("link:Spinner"),
        hover: None,
        click: None,
        subject: "heading:Spinner",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "a-spinner-announces-itself-as-loading",
        group: "feedback",
        what: "the indeterminate state is a named status region rather than a bare animation",
        open: None,
        hover: None,
        click: None,
        // The one component in this group whose accessible name is not empty,
        // and it is what a screen reader has to work from.
        subject: "status:Loading",
        expect: Count,
        expect_count: Some(18),
    ),
    (
        id: "and-the-smallest-spinner-still-has-a-box",
        group: "feedback",
        what: "the size scale bottoms out at a visible control rather than at nothing",
        open: None,
        hover: None,
        click: None,
        subject: "status:Loading",
        expect: Measures,
        expect_size: Some("16x16"),
    ),
    // Toast.
    (
        id: "the-toast-page-opens",
        group: "feedback",
        what: "the menu reaches the Toast showcase",
        open: Some("link:Toast"),
        hover: None,
        click: None,
        subject: "heading:Toast",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "no-toast-is-showing-to-begin-with",
        group: "feedback",
        what: "the page starts quiet",
        open: None,
        hover: None,
        click: None,
        subject: "status:Default toast message",
        expect: Absent,
    ),
    // Every toast on this page removes itself after four seconds, so the two
    // checks below carry deadlines shorter than that and each names the toast
    // its own press produced. The first version of the second check counted the
    // whole `status` family instead, and its baseline of one was the *previous*
    // toast: on a slower run that one had already expired, the count went
    // 1 -> 0, and a working component was reported broken by a four-second
    // timer. A check whose subject is a family the page also mutates on a clock
    // is a check that will eventually fail for the wrong reason.
    (
        id: "and-pressing-the-trigger-raises-one",
        group: "feedback",
        what: "a toast is created on demand and announced as a status",
        open: None,
        hover: None,
        click: Some("button:Show Default Toast"),
        subject: "status:Default toast message",
        expect: Paints,
        outcome_timeout_ms: 3000,
    ),
    (
        id: "and-the-dynamic-example-names-the-toast-it-appended",
        group: "feedback",
        what: "the list-backed example appends an item of its own rather than reusing one",
        open: None,
        hover: None,
        click: Some("button:Add Toast (Max 3)"),
        // Named without a role on purpose. This example picks its severity at
        // random from four values, and two of them are severe enough to take
        // the `alert` role rather than `status`, so a role-qualified subject
        // passes or fails on a coin toss. The counter is per press and this
        // group presses once, so the first message is the one to name.
        subject: "Limited message #1",
        expect: Paints,
        outcome_timeout_ms: 3000,
    ),
    // Tooltip. The only component in the suite whose behaviour needs a pointer.
    (
        id: "the-tooltip-page-opens",
        group: "feedback",
        what: "the menu reaches the Tooltip showcase",
        open: Some("link:Tooltip"),
        hover: None,
        click: None,
        subject: "heading:Tooltip",
        expect: Present,
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-tooltip-page-draws-the-tooltips-it-forces-open",
        group: "feedback",
        what: "the always-open example and the two arrow examples are showing",
        open: None,
        hover: None,
        click: None,
        subject: "tooltip:",
        expect: Count,
        expect_count: Some(3),
    ),
    (
        id: "and-hovering-a-trigger-adds-one-more",
        group: "feedback",
        what: "a tooltip appears for the pointer rather than only for the `open` prop",
        open: None,
        hover: Some("button:Hover me"),
        click: None,
        subject: "tooltip:",
        expect: Count,
        expect_count: Some(4),
        outcome_timeout_ms: 8000,
    ),
    (
        id: "the-tooltip-page-offers-every-placement",
        group: "feedback",
        what: "all four sides have a trigger",
        open: None,
        hover: None,
        click: None,
        subject: "button:Bottom with arrow",
        expect: Paints,
    ),
]
