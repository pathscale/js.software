// What the harness has to be told about this application.
//
// `Components` is a button rather than a link: it opens a menu instead of
// navigating, so it is listed as navigation and not as a surface of its own.
//
// A marker has to be absent from the page being left, not merely present on
// the page being reached: every one of these names is in the header of every
// page, so each surface is marked by a heading its own page owns.
AppProfile(
    surfaces: [
        (name: "home", opener: "Home", marker: Some("Build Exceptional UIs")),
        (name: "theming", opener: "Theming", marker: Some("Theme Editor")),
        (name: "docs", opener: "Docs", marker: Some("Quick Start")),
        (name: "layouts", opener: "Layouts", marker: Some("The two compiler passes")),
        (name: "showcases", opener: "Showcases", marker: Some("Component Showcases")),
    ],
    navigation_controls: ["Home", "Theming", "Docs", "Layouts", "Showcases", "Components"],
    home_opener: Some("Home"),
)
